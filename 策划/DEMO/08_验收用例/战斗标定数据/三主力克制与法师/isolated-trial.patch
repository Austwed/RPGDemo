+            var deployed = check.Battle.Soldiers.OrderBy(unit => unit.Id).ToArray();
+            if (deployed.Length != initial.Length ||
+                !initial.Zip(deployed, (before, after) => before.Id == after.Id && before.Side == after.Side &&
+                    before.Cell == after.Cell && before.OriginCommanderSlot == after.OriginCommanderSlot &&
+                    Kind(before) == after.Kind).All(same => same))
+                throw new InvalidOperationException($"role or spatial deployment changed across replacements: {scene} {seed} {mageCount}");
+            foreach (var before in initial.Where(unit => !convert.Contains(unit.Id)))
+            {
+                var after = check.Battle.Soldier(before.Id);
+                if (before.Health != after.Health || before.Stats.Damage != after.Stats.Damage ||
+                    before.Stats.Defense != after.Stats.Defense)
+                    throw new InvalidOperationException($"unchanged unit stats moved: {scene} {seed} {mageCount} {before.Id}");
+            }
+            return opening;
+        }
+
+        private static MageRoleResult MeasureMageRole(string scene, int grade, int seed, int index,
+            BaseCampaignBattle opening, bool pin, int maxSeconds)
+        {
+            var session = new BaseCampaignSession(opening);
+            session.Bind();
+            if (!session.Battle.Start(out string error))
+                throw new InvalidOperationException("cannot start explicit mage role placement: " + error);
+            var run = new RealtimeCampaignBattle(session, "normal");
+            run.Model.SwordContactPinEnabled = pin;
+            run.EnableBattlefieldExits();
+            if (scene == "second") BaseDemoDefense.Configure(run);
+            var allies = session.Battle.Soldiers.Where(unit => unit.Side == BattleSide.A).ToArray();
+            var enemies = session.Battle.Soldiers.Where(unit => unit.Side == BattleSide.B).ToArray();
+            var captain = enemies.FirstOrDefault(unit => unit.Kind == SoldierKind.Hero);
+            var row = new MageRoleResult
+            {
+                Pin = pin, Scene = scene, Grade = grade, Seed = seed, Index = index, EnemyCount = enemies.Length,
+                CaptainHp = captain?.Stats.Health ?? 0, CaptainAttack = captain?.Stats.Damage ?? 0,
+                CaptainDefense = captain?.Stats.Defense ?? 0
+            };
+            run.Model.SetPaused(false);
+            for (int tick = 0; tick < maxSeconds * 8 && !run.VictoryExitOpen && session.Battle.Phase == BattlePhase.Fighting; tick++)
+                run.Tick(.125);
+            row.Outcome = run.VictoryExitOpen ? "SideAWin" : session.Battle.Report?.Outcome.ToString() ?? "Timeout";
+            row.Won = row.Outcome == "SideAWin";
+            row.Timeout = row.Outcome is "Timeout" or "RoundLimit";
+            row.Seconds = run.Model.Elapsed;
+            row.AllyDeaths = allies.Count(unit => unit.InstantDead);
+            row.EnemyDeaths = enemies.Count(unit => unit.InstantDead);
+            row.AllyDown = allies.Count(unit => !unit.InstantDead && unit.KnockedDown);
+            row.EnemyDown = enemies.Count(unit => !unit.InstantDead && unit.KnockedDown);
+            foreach (var packet in run.RpgAttackHistory.Where(packet => packet.ImpactApplied &&
+                session.Battle.Soldier(packet.SourceId - 1)?.Side == BattleSide.A))
+            {
+                switch (session.Battle.Soldier(packet.SourceId - 1).Kind)
+                {
+                    case SoldierKind.Melee: row.SwordDamage += packet.DamageApplied; break;
+                    case SoldierKind.Ranged: row.BowDamage += packet.DamageApplied; break;
+                    case SoldierKind.Cavalry: row.CavalryDamage += packet.DamageApplied; break;
+                    case SoldierKind.Mage: row.MageDamage += packet.DamageApplied; break;
+                }
+            }
+            return row;
+        }
+
+        private static void WriteMagePairedSummary(TextWriter output, MageRoleResult[] baseline, MageRoleResult[] variant)
+        {
+            var changed = variant[0];
+            var pairs = baseline.Zip(variant, (before, after) => (before, after)).ToArray();
+            if (pairs.Any(pair => pair.before.Seed != pair.after.Seed))
+                throw new InvalidOperationException("paired mage role seeds differ");
+            var bothWon = pairs.Where(pair => pair.before.Won && pair.after.Won).ToArray();
+            int winsBefore = baseline.Count(row => row.Won), winsAfter = variant.Count(row => row.Won);
+            double seconds = pairs.Average(pair => pair.after.Seconds - pair.before.Seconds);
+            double deaths = pairs.Average(pair => pair.after.AllyDeaths - pair.before.AllyDeaths);
+            output.WriteLine(MageCsv(changed.Pin ? 1 : 0, changed.Scene, changed.Grade, MageRoleComposition[changed.Index],
+                pairs.Length, winsBefore, winsAfter, winsAfter - winsBefore,
+                pairs.Count(pair => !pair.before.Won && pair.after.Won),
+                pairs.Count(pair => pair.before.Won && !pair.after.Won),
+                baseline.Count(row => row.Timeout), variant.Count(row => row.Timeout), baseline.Average(row => row.Seconds),
+                variant.Average(row => row.Seconds), seconds, bothWon.Length,
+                bothWon.Length == 0 ? "" : bothWon.Average(pair => pair.after.Seconds - pair.before.Seconds).ToString("R", Invariant),
+                baseline.Average(row => row.AllyDeaths), variant.Average(row => row.AllyDeaths), deaths,
+                pairs.Average(pair => pair.after.EnemyDeaths - pair.before.EnemyDeaths)));
+            Debug.Log($"[MageRole] pin={changed.Pin} {changed.Scene} grade={changed.Grade} formation={MageRoleComposition[changed.Index]} wins={winsBefore}/{pairs.Length}->{winsAfter}/{pairs.Length} meanSecondsDelta={seconds:F2} meanAllyDeathsDelta={deaths:F2} bothWon={bothWon.Length}");
+        }
+
+        private static string MageCsv(params object[] values) => string.Join(",", values.Select(value => Convert.ToString(value, Invariant)));
+    }
+}
