+        public static void VerifyMainTrio()
+        {
+            try
+            {
+                WriteMainTrio();
+                Debug.Log("[MainTrio] PASS");
+                UnityEditor.EditorApplication.Exit(0);
+            }
+            catch (Exception error)
+            {
+                Debug.LogException(error);
+                UnityEditor.EditorApplication.Exit(1);
+            }
+        }
+
+        private static void WriteMainTrio()
+        {
+            string variants = Arg("trio-variants", "baseline,s12a14");
+            int startSeed = int.Parse(Arg("trio-seed", "193703"), Invariant);
+            int seedCount = int.Parse(Arg("trio-count", "8"), Invariant);
+            int workers = int.Parse(Arg("trio-workers", "8"), Invariant);
+            string output = Arg("trio-out", "Logs/trio.csv");
+            string map = Arg("trio-map", "flat");
+            const string rulesFile = "Assets/Resources/DemoBalance/DemoBalance.json";
+            string rulesJson = File.ReadAllText(rulesFile);
+            using var writer = new StreamWriter(output);
+            writer.WriteLine("variant,map,wanted,counter,size,grade,seed,mirror,outcome,seconds,first_strike,first_hit,first_hit_s,contact_wanted_s,contact_counter_s,pin_wanted_s,pin_counter_s,hp_wanted,hp_counter,max_hp_wanted,max_hp_counter,down_wanted,down_counter,dead_wanted,dead_counter,shoves");
+            foreach (string variant in variants.Split(','))
+            {
+                bool pin = variant != "baseline";
+                var state = JsonUtility.FromJson<BaseState>(File.ReadAllText("Assets/Resources/DemoStages/defense-male.json"));
+                var rules = JsonUtility.FromJson<DemoBalancePackage>(rulesJson).Rules;
+                state.Demo.Rpg = rules;
+                if (pin)
+                {
+                    string[] attack = variant.Substring(1).Split('a');
+                    rules.Templates.Single(t => t.Id == "soldier_warrior").Attack = int.Parse(attack[0], Invariant);
+                    rules.Templates.Single(t => t.Id == "soldier_archer").Attack = int.Parse(attack[1], Invariant);
+                }
+                rules.Validate();
+                var jobs = (from pair in new[] { (1, 0), (0, 2), (2, 1) }
+                            from size in new[] { 8, 16 }
+                            from grade in Enumerable.Range(0, 3)
+                            from index in Enumerable.Range(0, seedCount)
+                            from mirror in new[] { false, true }
+                            select (pair, size, grade, index, mirror)).ToArray();
+                var rows = new string[jobs.Length];
+                Parallel.For(0, jobs.Length, new ParallelOptions { MaxDegreeOfParallelism = workers }, i =>
+                {
+                    var job = jobs[i];
+                    int seed = startSeed + job.index * 1009;
+                    rows[i] = MainTrioMatch(state, rules, variant, map, pin,
+                        job.pair.Item1, job.pair.Item2, job.size, job.grade, seed, job.mirror);
+                });
+                foreach (string row in rows) writer.WriteLine(row);
+                writer.Flush();
+                Debug.Log($"[MainTrio] {variant} {map} {rows.Length} matches, seed={startSeed}");
+            }
+        }
+
+        private static string MainTrioMatch(BaseState state, RpgRules rules, string variant, string map, bool pin,
+            int wanted, int counter, int size, int grade, int seed, bool mirror)
+        {
+            var setup = ScenarioFor("flat", state);
+            if (map == "choke")
+                for (int z = 2; z <= 7; z++)
+                    for (int x = 6; x <= 7; x++)
+                        setup.Scenario.Board.Cell(new GridPosition(x, z)).Terrain = TerrainKind.Wall;
+            int[] left = new int[4], right = new int[4];
+            left[wanted] = size;
+            right[counter] = size;
+            var session = StartMatch("flat", setup, state, rules, 0, grade, seed, mirror, left, right);
+            var run = new RealtimeCampaignBattle(session, "normal");
+            run.Model.SwordContactPinEnabled = pin;
+            var side = mirror ? BattleSide.B : BattleSide.A;
+            var leftUnits = run.Model.Units.Where(u => session.Battle.Soldier(u.Id - 1).Side == side).ToArray();
+            var rightUnits = run.Model.Units.Where(u => session.Battle.Soldier(u.Id - 1).Side != side).ToArray();
+            var a = session.Battle.Soldiers.Where(u => u.Side == side).ToArray();
+            var b = session.Battle.Soldiers.Where(u => u.Side != side).ToArray();
+            if (a.Length != size || b.Length != size || a.Any(u => BaseRpg.Profession(u.ProfessionKind) != wanted) ||
+                b.Any(u => BaseRpg.Profession(u.ProfessionKind) != counter)) throw new InvalidOperationException("Invalid team or mirror");
+            double contactA = 0, contactB = 0;
+            var unitsById = run.Model.Units.ToDictionary(u => u.Id);
+            int InContact(BaseConquest.RealtimePrototype.PrototypeUnit[] actors)
+            {
+                int engaged = 0;
+                foreach (var unit in actors)
+                {
+                    if (unit.Alive && !unit.Ranged && unitsById.TryGetValue(unit.TargetId, out var target) &&
+                        target.Alive && target.Side != unit.Side && run.Model.InAttackRadius(unit, target) &&
+                        (run.Model.CanTarget?.Invoke(unit, target) ?? true) && run.Model.ClearAttack(unit.Position, target.BodyCenter))
+                        engaged++;
+                }
+                return engaged;
+            }
+            run.Model.SetPaused(false);
+            for (int frame = 0; frame < 360 && session.Battle.Phase != BattlePhase.Finished; frame++)
+            {
+                run.Tick(.25);
+                contactA += .25 * InContact(leftUnits);
+                contactB += .25 * InContact(rightUnits);
+            }
+            var result = session.Battle.Report?.Outcome ?? BattleOutcome.RoundLimit;
+            string outcome = result is BattleOutcome.SideAWin or BattleOutcome.SideBWin
+                ? ((result == BattleOutcome.SideAWin) == !mirror ? "wanted" : "counter")
+                : result == BattleOutcome.RoundLimit ? "timeout" : "draw";
+            string Team(RpgAttackPacket attack) => attack == null ? "none" :
+                session.Battle.Soldier(attack.SourceId - 1).Side == side ? "wanted" : "counter";
+            var strike = run.RpgAttackHistory.FirstOrDefault();
+            var hit = run.RpgAttackHistory.Where(packet => packet.ImpactApplied && packet.DamageApplied > 0)
+                .OrderBy(packet => packet.ArriveAt).ThenBy(packet => packet.Id).FirstOrDefault();
+            double PinTime(BaseConquest.RealtimePrototype.PrototypeUnit[] actors) => actors.Sum(run.Model.SwordContactPinnedSeconds);
+            return FormattableString.Invariant($"{variant},{map},{wanted},{counter},{size},{grade},{seed},{(mirror ? 1 : 0)},{outcome},{run.Model.Elapsed:F2},{Team(strike)},{Team(hit)},{hit?.ArriveAt ?? -1:F2},{contactA:F2},{contactB:F2},{PinTime(leftUnits):F2},{PinTime(rightUnits):F2},{a.Sum(u => u.Health):F2},{b.Sum(u => u.Health):F2},{a.Sum(u => u.Stats.Health):F2},{b.Sum(u => u.Stats.Health):F2},{a.Count(u => !u.IsActive)},{b.Count(u => !u.IsActive)},{a.Count(u => u.InstantDead)},{b.Count(u => u.InstantDead)},{run.Model.ShoveMoves}");
+        }
+    }
+}
+#endif
