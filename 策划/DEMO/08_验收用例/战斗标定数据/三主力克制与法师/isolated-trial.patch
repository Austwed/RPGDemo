+using System;
+using System.Linq;
+using System.Reflection;
+using BaseConquest.Battle;
+using BaseConquest.RealtimePrototype;
+using UnityEngine;
+
+namespace BaseConquest.Base
+{
+    public static partial class PowerCalibrationMatrix
+    {
+        public static void VerifySwordContactPin()
+        {
+            VerifyContactPinFourProfessions();
+            VerifyContactPinSwitchAndRelease();
+            VerifyContactPinFinishesStep();
+            VerifyContactPinForcedDisplacement();
+            Debug.Log("[SwordContactPin] PASS");
+        }
+
+        private static (RealtimeCampaignBattle run, PrototypeUnit sword, PrototypeUnit[] targets)
+            SwordPinMatch(int[] enemies, bool enabled = true, bool keepCombatAlive = false)
+        {
+            var run = TargetDiceMatch(0, enemies, allyCount: keepCombatAlive ? 2 : 1);
+            var model = run.Model;
+            var allies = model.Units.Where(unit => unit.Side == PrototypeSide.Ally).OrderBy(unit => unit.Id).ToArray();
+            var sword = allies[0];
+            var reserve = allies.Skip(1).FirstOrDefault();
+            var targets = model.Units.Where(unit => unit.Side == PrototypeSide.Enemy).OrderBy(unit => unit.Id).ToArray();
+            model.SwordContactPinEnabled = enabled;
+            model.CanMove = unit => unit.Side == PrototypeSide.Enemy;
+            model.CanTarget = (a, b) => a.Side != b.Side && a != reserve && b != reserve;
+            if (reserve != null) PlaceTargetDiceActor(run, reserve, 1.25, 8.25);
+            PlaceTargetDiceActor(run, sword, 4.25, 4.25);
+            PlaceTargetDiceActor(run, targets[0], 4.75, 4.25);
+            if (targets.Length > 1) PlaceTargetDiceActor(run, targets[1], 4.25, 4.75);
+            return (run, sword, targets);
+        }
+
+        private static void VerifyContactPinFourProfessions()
+        {
+            for (int role = 0; role < 4; role++)
+            {
+                var enemies = new int[4];
+                enemies[role] = 1;
+                var (run, sword, targets) = SwordPinMatch(enemies, keepCombatAlive: true);
+                var target = targets[0];
+                var model = run.Model;
+                var exit = new PrototypePoint(8.25, 4.25);
+                var start = target.Position;
+                FocusContactPin(run, sword, target);
+                RequireTargetDice(model.IssueOrder(-1, -1, PrototypeOrder.Retreat, exit, side: PrototypeSide.Enemy),
+                    "contact pin accepts and preserves a queued retreat");
+                AdvanceTargetDice(run, 76);
+                RequireTargetDice(model.ContactPinActive(target) && target.Order == PrototypeOrder.Retreat &&
+                    (target.Position - start).Length < 1e-8 && !target.Moving && model.SwordContactPinStarts(target) == 1 &&
+                    model.SwordContactPinnedSeconds(target) > 1 &&
+                    run.RpgAttackHistory.Any(attack => attack.SourceId == target.Id && attack.TargetId == sword.Id),
+                    "ordinary role " + role + " must remain held while retreat stays pending and it can attack");
+                if (target.Mounted)
+                    RequireTargetDice(!InvokeContactPinShove(model, target, sword.Cell),
+                        "held cavalry may not initiate a shove");
+                sword.Health = 1;
+                sword.KnockedDown = true;
+                AdvanceTargetDice(run, 25);
+                RequireTargetDice(!model.ContactPinActive(target) && target.Order == PrototypeOrder.Retreat &&
+                    target.DistanceTravelled > 0, "queued retreat should resume on sword down");
+                Debug.Log($"[SwordContactPin] victim role={role} held={model.SwordContactPinnedSeconds(target):F2}s starts={model.SwordContactPinStarts(target)} counterattacks={run.RpgAttackHistory.Count(attack => attack.SourceId == target.Id)} retreatResumed={target.DistanceTravelled:F2}");
+            }
+
+            var (control, controlSword, controlTargets) = SwordPinMatch(new[] { 0, 0, 1, 0 }, enabled:false);
+            var rider = controlTargets[0];
+            FocusContactPin(control, controlSword, rider);
+            RequireTargetDice(control.Model.IssueOrder(-1, -1, PrototypeOrder.Retreat, new PrototypePoint(8.25, 4.25),
+                side: PrototypeSide.Enemy), "baseline retreat fixture");
+            AdvanceTargetDice(control, 25);
+            RequireTargetDice(!control.Model.ContactPinActive(rider) && rider.DistanceTravelled > 0,
+                "baseline remains free to move out of the same close position");
+        }
+
+        private static void VerifyContactPinSwitchAndRelease()
+        {
+            var (run, sword, targets) = SwordPinMatch(new[] { 2, 0, 0, 0 });
+            var model = run.Model;
+            model.CanMove = _ => false;
+            var first = targets[0];
+            var second = targets[1];
+            FocusContactPin(run, sword, first);
+            RequireTargetDice(model.IssueOrder(0, -1, PrototypeOrder.Focus, sword.Position, sword.Id, side: PrototypeSide.Enemy), "mutual focus");
+            AdvanceTargetDice(run, 4);
+            RequireTargetDice(model.ContactPinActive(first) && !model.ContactPinActive(second) &&
+                model.ContactPinActive(sword), "one assigned target and simultaneous mutual pins");
+            FocusContactPin(run, sword, second);
+            AdvanceTargetDice(run, 4);
+            RequireTargetDice(!model.ContactPinActive(first) && model.ContactPinActive(second), "switch releases old target");
+
+            model.HeightShotClear = (_, _) => false;
+            AdvanceTargetDice(run, 4);
+            RequireTargetDice(!model.ContactPinActive(second), "shot obstruction releases pin");
+            model.HeightShotClear = null;
+            model.CanTarget = (a, b) => a.Side != b.Side && b != second;
+            AdvanceTargetDice(run, 4);
+            RequireTargetDice(!model.ContactPinActive(second), "a hidden target cannot be pinned");
+            model.CanTarget = (a, b) => a.Side != b.Side;
+            FocusContactPin(run, sword, second);
+            second.Role = PrototypeRole.Leader;
+            second.ReadyAt = 100;
+            AdvanceTargetDice(run, 4);
+            RequireTargetDice(!model.ContactPinActive(second), "captains are outside the pin rule");
+            second.Role = PrototypeRole.Melee;
+            PlaceTargetDiceActor(run, second, 4.25, 6.25);
+            FocusContactPin(run, sword, second);
+            AdvanceTargetDice(run, 4);
+            RequireTargetDice(!model.ContactPinActive(second), "out-of-radius assignment cannot pin");
+            PlaceTargetDiceActor(run, second, 4.25, 4.75);
+            FocusContactPin(run, sword, second);
+            AdvanceTargetDice(run, 4);
+            RequireTargetDice(model.ContactPinActive(second), "back in contact");
+            model.OnlyExitMovement = true;
+            RequireTargetDice(!model.ContactPinActive(second), "victory exit is not held");
+            model.OnlyExitMovement = false;
+            run.Battle.FinishRealtime(BattleOutcome.SideAWin);
+            RequireTargetDice(!model.ContactPinActive(second), "finished battle clears all live pins");
+        }
+
+        private static void VerifyContactPinFinishesStep()
+        {
+            var (run, sword, targets) = SwordPinMatch(new[] { 0, 0, 1, 0 });
+            var rider = targets[0];
+            var model = run.Model;
+            PlaceTargetDiceActor(run, sword, 4.25, 4.75);
+            RequireTargetDice(!model.InAttackRadius(sword, rider), "step fixture starts just outside melee radius");
+            FocusContactPin(run, sword, rider);
+            RequireTargetDice(model.IssueOrder(-1, -1, PrototypeOrder.Retreat, new PrototypePoint(4.75, 8.25),
+                side: PrototypeSide.Enemy), "step retreat fixture");
+            bool pinDuringStep = false;
+            for (int i = 0; i < 45; i++)
+            {
+                AdvanceTargetDice(run, 1);
+                pinDuringStep |= model.ContactPinActive(rider) && rider.Moving;
+            }
+            RequireTargetDice(pinDuringStep && model.ContactPinActive(rider) && !rider.Moving &&
+                Math.Abs(rider.Position.Z - 4.75) < 1e-8 && Math.Abs(rider.DistanceTravelled - .5) < 1e-8,
+                "pin should let an already reserved step finish and block the next one");
+        }
+
+        private static void VerifyContactPinForcedDisplacement()
+        {
+            var model = new RealtimeBattlePrototype(new PrototypeArena(PrototypeLayout.Open))
+            {
+                SwordContactPinEnabled = true,
+                AutonomousOutcome = false
+            };
+            var sword = model.AddUnit(PrototypeSide.Ally, PrototypeRole.Melee, new PrototypePoint(4.25, 4.25));
+            var bow = model.AddUnit(PrototypeSide.Enemy, PrototypeRole.Archer, new PrototypePoint(4.75, 4.25));
+            var rider = model.AddUnit(PrototypeSide.Ally, PrototypeRole.Melee, new PrototypePoint(4.75, 3.75));
+            sword.AttackRange = .5;
+            rider.Mounted = true;
+            model.CanTarget = (a, b) => a == sword && b == bow;
+            // The pure prototype uses commander IDs only for leaders. Set the ordinary attacker explicitly.
+            sword.Order = PrototypeOrder.Focus;
+            sword.TargetId = bow.Id;
+            model.SetPaused(false);
+            model.Tick(RealtimeBattlePrototype.FixedSeconds);
+            RequireTargetDice(model.ContactPinActive(bow), "forced displacement victim starts pinned");
+            var from = bow.Position;
+            RequireTargetDice(InvokeContactPinShove(model, rider, bow.Cell) && (bow.Position - from).Length > .4,
+                "a legal unpinned rider may forcibly displace a pinned non-cavalry soldier");
+            model.Tick(RealtimeBattlePrototype.FixedSeconds);
+            RequireTargetDice(!model.ContactPinActive(bow), "shove outside radius releases pin on next sample");
+        }
+
+        private static void FocusContactPin(RealtimeCampaignBattle run, PrototypeUnit sword, PrototypeUnit target)
+        {
+            RequireTargetDice(run.Model.IssueOrder(-1, -1, PrototypeOrder.Focus, target.Position, target.Id,
+                side: sword.Side), "sword focus fixture");
+        }
+
+        private static bool InvokeContactPinShove(RealtimeBattlePrototype model, PrototypeUnit rider, int cell)
+        {
+            var method = typeof(RealtimeBattlePrototype).GetMethod("TryShoveThrough", BindingFlags.Instance | BindingFlags.NonPublic);
+            return (bool)method.Invoke(model, new object[] { rider, cell });
+        }
+    }
