+using System;
+using System.Linq;
+using BaseConquest.Battle;
+using BaseConquest.RealtimePrototype;
+using UnityEngine;
+
+namespace BaseConquest.Base
+{
+    public static partial class PowerCalibrationMatrix
+    {
+        private const double MageSplashTestHealth = 1000;
+
+        public static void VerifyMageSplashRules()
+        {
+            int hitSeed = MageSplashSeed(10);
+            int missSeed = MageSplashSeed(1);
+            VerifyMageSplashFullRing(hitSeed);
+            VerifyMageSplashEdge(hitSeed);
+            VerifyMageSplashObstacles(hitSeed, false);
+            VerifyMageSplashObstacles(hitSeed, true);
+            VerifyMageSplashInFlight(hitSeed, missSeed);
+            Debug.Log("[MageSplashRules] PASS");
+        }
+
+        private static int MageSplashSeed(int face) => Enumerable.Range(931500, 1000)
+            .First(seed => 1 + (int)(BattleSimulation.StableRoll(seed, 1, 401) * 10) == face);
+
+        private static (RealtimeCampaignBattle Run, PrototypeUnit Source, PrototypeUnit[] Enemies) MageSplashMatch(
+            int seed, int enemies, int allies = 1, int role = 3)
+        {
+            var run = TargetDiceMatch(role, new[] { enemies, 0, 0, 0 }, seed, allies);
+            var source = run.Model.Units.First(u => u.Side == PrototypeSide.Ally);
+            var opponents = run.Model.Units.Where(u => u.Side == PrototypeSide.Enemy).OrderBy(u => u.Id).ToArray();
+            return (run, source, opponents);
+        }
+
+        private static void SetMageSplashPosition(RealtimeCampaignBattle run, PrototypeUnit unit, double x, double z)
+        {
+            var point = new PrototypePoint(x, z);
+            int cell = run.Model.Arena.CellAt(point);
+            RequireMageSplash(run.Model.Arena.FineWalkable(cell), $"cannot stand at {x}, {z}");
+            unit.Cell = cell;
+            unit.Position = unit.Goal = unit.Anchor = point;
+            unit.NextCell = unit.PreviousCell = unit.MoveGoal = -1;
+            unit.Progress = 0;
+        }
+
+        private static void SettleMageSplashShot(RealtimeCampaignBattle run, RpgAttackPacket packet)
+        {
+            RequireMageSplash(!packet.Settled, "projectile has real flight time");
+            run.Model.CanTarget = (_, _) => false;
+            int frames = (int)Math.Ceiling((packet.ArriveAt - run.Model.Elapsed) / RealtimeBattlePrototype.FixedSeconds) + 2;
+            AdvanceTargetDice(run, frames);
+            RequireMageSplash(packet.Settled && run.RpgAttackHistory.Count == 1, "settled one original attack packet");
+        }
+
+        private static void VerifyMageSplashFullRing(int seed)
+        {
+            float baseDamage = 0;
+            foreach (int mode in Enumerable.Range(0, 3))
+            {
+                var (run, mage, enemies) = MageSplashMatch(seed, 10);
+                bool enabled = mode != 0;
+                RequireMageSplash(!run.MageSplashEnabled, "new runtime defaults to disabled");
+                run.MageSplashEnabled = enabled;
+                var target = enemies[0];
+                SetMageSplashPosition(run, mage, 4.25, 4.25);
+                SetMageSplashPosition(run, target, 6.25, 4.25);
+                int index = 1;
+                for (int z = -1; z <= 1; z++)
+                    for (int x = -1; x <= 1; x++)
+                    {
+                        if (x == 0 && z == 0) continue;
+                        if (x == -1 && z == -1)
+                            SetMageSplashPosition(run, enemies[index++], 5.51, 3.51);
+                        else SetMageSplashPosition(run, enemies[index++], 6.25 + x * .5, 4.25 + z * .5);
+                    }
+                // Exercise a transient overlap of live fine-cell anchors independently of navigation reservations.
+                SetMageSplashPosition(run, enemies[9], 5.99, 3.99);
+                enemies[9].Cell = run.Model.Arena.CellAt(new PrototypePoint(5.25, 3.75));
+                if (mode == 2)
+                {
+                    target.Health = 3;
+                    run.Battle.Soldier(target.Id - 1).Health = 3;
+                    run.ImmediateVictory = () => !target.Alive;
+                }
+                var packet = ReleaseTargetDiceAttack(run, mage, target);
+                SettleMageSplashShot(run, packet);
+                RequireMageSplash(packet.Hit && packet.Critical && packet.ImpactApplied && packet.DamageType == "magic" &&
+                    packet.MageSplashEligible == enabled, "primary packet preserves the magic roll and launch mode");
+                if (mode == 0) baseDamage = packet.DamageApplied;
+                RequireMageSplash(baseDamage > 3 && (mode == 2 ? packet.DamageApplied <= 3 : NearSplash(packet.DamageApplied, baseDamage)),
+                    "primary original damage and overkill cap");
+                RequireMageSplash(packet.SplashTargetsHit == (enabled ? 8 : 0) &&
+                    NearSplash(packet.SplashDamageApplied, enabled ? baseDamage : 0), "eight shares sum to one uncapped primary hit");
+                for (int i = 1; i <= 8; i++)
+                {
+                    var victim = enemies[i];
+                    RequireMageSplash(NearSplash(MageSplashTestHealth - victim.Health, enabled ? baseDamage / 8 : 0) &&
+                        (!enabled || run.Battle.Soldier(victim.Id - 1).LastHitSourceId == mage.Id - 1),
+                        $"ring cell {i} loses exactly one share and attributes damage to the caster");
+                }
+                RequireMageSplash(enemies[9].Health == MageSplashTestHealth, "same cell does not receive a second share");
+                if (mode == 2)
+                    RequireMageSplash(!target.Alive && run.Battle.Phase == BattlePhase.Finished,
+                        "primary lethal blow locks victory after splash from the same impact");
+                Debug.Log($"[MageSplashRules] full ring enabled={enabled} overkill={mode == 2} roll={packet.Selected} " +
+                    $"primary={packet.DamageApplied:0.###} splash={packet.SplashDamageApplied:0.###} hits={packet.SplashTargetsHit}");
+            }
+        }
+
+        private static void VerifyMageSplashEdge(int seed)
+        {
+            var (run, mage, enemies) = MageSplashMatch(seed, 4, 2);
+            run.MageSplashEnabled = true;
+            var friend = run.Model.Units.Last(u => u.Side == PrototypeSide.Ally);
+            SetMageSplashPosition(run, mage, 2.25, 4.25);
+            SetMageSplashPosition(run, friend, .75, 4.25);
+            SetMageSplashPosition(run, enemies[0], .25, 4.25);
+            SetMageSplashPosition(run, enemies[1], .25, 3.75);
+            SetMageSplashPosition(run, enemies[2], 13.75, 3.75);
+            SetMageSplashPosition(run, enemies[3], .25, 4.75);
