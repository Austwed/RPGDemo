+        private static double ScoutDiscoveryTime(int scoutRole)
+        {
+            var run = TargetDiceMatch(scoutRole, new[] { 1, 0, 0, 0 });
+            var scout = run.Model.Units.Single(u => u.Side == PrototypeSide.Ally);
+            var hiddenEnemy = run.Model.Units.Single(u => u.Side == PrototypeSide.Enemy);
+            var battle = run.Battle;
+            BaseSceneRules.ApplyBanditSight(battle.Scenario);
+            var observed = battle.Soldier(hiddenEnemy.Id - 1);
+            battle.Soldier(scout.Id - 1).Stats.SightRadius = 3;
+            PlaceTargetDiceActor(run, scout, 2.25, 4.25);
+            PlaceTargetDiceActor(run, hiddenEnemy, 10.25, 4.25);
+            run.Model.CanTarget = (a, b) => a.Side != b.Side &&
+                battle.Vision.CanSee(a.Side == PrototypeSide.Ally ? BattleSide.A : BattleSide.B, battle.Soldier(b.Id - 1));
