+                    for (int index = 0; index < MageRoleComposition.Length; index++)
+                    {
+                        var baseline = Enumerable.Range(0, samples).Select(trial => results[trial, index, 0]).ToArray();
+                        var variant = Enumerable.Range(0, samples).Select(trial => results[trial, index, 1]).ToArray();
+                        WriteMageSplashSummary(summary, baseline, variant, pin);
+                    }
+                    detail.Flush();
+                    summary.Flush();
