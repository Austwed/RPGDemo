+
+        private static bool MageSplashAnchored(string scene) => MageSplashClustered(scene) || MageSplashSpread(scene);
+        private static bool MageSplashClustered(string scene) => scene is "clustered" or "clustered-swords";
+        private static bool MageSplashSpread(string scene) => scene is "spread" or "spread-swords";
+        private static int[] MageSplashGuardCounts(string scene) => scene.EndsWith("-swords", StringComparison.Ordinal) ?
+            new[] { 6, 0, 0, 0 } : new[] { 0, 6, 0, 0 };
+
+        private static void PlaceMageSplashTargets(RealtimeCampaignBattle run, string scene)
+        {
+            // Change all six starting tiles together. The standard restore validates static occupancy,
+            // path anchors and body separation, and rebuilds reservations for the test model.
+            var fixture = run.Model.Capture();
+            var enemies = fixture.Units.Where(unit => unit.Side == PrototypeSide.Enemy).OrderBy(unit => unit.Id).ToArray();
+            SoldierKind kind = scene.EndsWith("-swords", StringComparison.Ordinal) ? SoldierKind.Melee : SoldierKind.Ranged;
+            if (enemies.Length != 6 || enemies.Any(enemy => run.Battle.Soldier(enemy.Id - 1).Kind != kind))
+                throw new InvalidOperationException($"density fixture requires six matching {kind} soldiers");
+            bool clustered = MageSplashClustered(scene);
+            var arena = run.Model.Arena;
+            for (int i = 0; i < enemies.Length; i++)
+            {
+                var slot = clustered ? new PrototypePoint(8.25 + .5 * (i % 2), 3.75 + .5 * (i / 2)) :
+                    new PrototypePoint(6.75 + 3 * (i % 2), 1.25 + 3 * (i / 2));
+                int cell = arena.CellAt(slot);
+                if (!arena.FineWalkable(cell) || (arena.Center(cell) - slot).Length > 1e-8)
+                    throw new InvalidOperationException($"density fixture invalid tile ({slot.X},{slot.Z}), arena={arena.FineColumns}x{arena.FineRows}");
+                var enemy = enemies[i];
+                enemy.Cell = enemy.PreviousCell = cell;
+                enemy.Position = enemy.Goal = enemy.Anchor = slot;
+                enemy.NextCell = enemy.MoveGoal = enemy.AttackSlot = enemy.TargetId = -1;
+                enemy.Progress = 0;
+            }
+            run.Model.Restore(fixture, RealtimeBattlePrototype.RpgAttackDamageLimit);
+            var previous = run.Model.CanMove;
+            // Both formations can attack from their deployed tiles, while transit and shove cannot erase the density control.
+            run.Model.CanMove = unit => unit.Side != PrototypeSide.Enemy && (previous?.Invoke(unit) ?? true);
+            run.RefreshDeveloperState();
+        }
+
+        private static MageSplashResult MeasureMageSplash(string scene, int grade, int seed, int index,
+            BaseCampaignBattle opening, bool splash, bool pin, int maxSeconds)
+        {
+            var session = new BaseCampaignSession(opening);
+            session.Bind();
+            if (!session.Battle.Start(out string error))
+                throw new InvalidOperationException("cannot start mage splash test: " + error);
+            var run = new RealtimeCampaignBattle(session, "normal") { MageSplashEnabled = splash };
+            run.Model.SwordContactPinEnabled = pin;
+            run.EnableBattlefieldExits();
+            if (MageSplashAnchored(scene)) PlaceMageSplashTargets(run, scene);
+            if (scene == "second")
+            {
+                if (session.Opening.EventId != BaseDemoDefense.SecondEventId || run.HasBattlefieldExits ||
+                    session.Battle.Soldiers.Count(unit => unit.Kind == SoldierKind.Hero && unit.Side == BattleSide.B) != 3)
+                    throw new InvalidOperationException("second-wave fixture must use the full release encounter without exits");
+                BaseDemoDefense.Configure(run);
+            }
+
+            var allies = session.Battle.Soldiers.Where(unit => unit.Side == BattleSide.A).ToArray();
+            var enemies = session.Battle.Soldiers.Where(unit => unit.Side == BattleSide.B).ToArray();
+            var enemyActors = run.Model.Units.Where(unit => unit.Side == PrototypeSide.Enemy).OrderBy(unit => unit.Id).ToArray();
+            var captain = enemies.FirstOrDefault(unit => unit.Kind == SoldierKind.Hero);
+            var arena = run.Model.Arena;
+            int neighbors = 0;
+            for (int a = 0; a < enemyActors.Length; a++)
+            for (int b = a + 1; b < enemyActors.Length; b++)
+            {
+                int first = enemyActors[a].Cell, second = enemyActors[b].Cell;
+                if (Math.Abs(first % arena.FineColumns - second % arena.FineColumns) <= 1 &&
+                    Math.Abs(first / arena.FineColumns - second / arena.FineColumns) <= 1)
+                    neighbors++;
+            }
+            if (MageSplashClustered(scene) && neighbors != 11 || MageSplashSpread(scene) && neighbors != 0)
+                throw new InvalidOperationException("actual initial enemy density did not match the controlled fixture");
+
+            var row = new MageSplashResult
+            {
+                Splash = splash, Scene = scene, Grade = grade, Seed = seed, Index = index,
+                EnemyCount = enemies.Length, InitialNeighborPairs = neighbors,
+                EnemyMages = enemies.Count(unit => unit.ProfessionKind == SoldierKind.Mage),
+                CaptainHp = captain?.Stats.Health ?? 0, CaptainAttack = captain?.Stats.Damage ?? 0,
+                CaptainDefense = captain?.Stats.Defense ?? 0,
+                Fixture = string.Join("|", enemyActors.Select(actor =>
+                {
+                    var soldier = session.Battle.Soldier(actor.Id - 1);
+                    return string.Join(":", actor.Id, actor.Cell, soldier.Kind,
+                        soldier.Stats.Health.ToString("R", Invariant), soldier.Stats.Damage.ToString("R", Invariant),
+                        soldier.Stats.Defense.ToString("R", Invariant));
+                }))
+            };
+            var previous = run.Model.DamageApplied;
+            run.Model.DamageApplied = (source, target, actual) =>
+            {
+                previous?.Invoke(source, target, actual);
+                if (double.IsNaN(row.FirstEnemyDown) && target.Side == PrototypeSide.Enemy &&
+                    (target.KnockedDown || target.Health <= 0)) row.FirstEnemyDown = run.Model.Elapsed;
+            };
+            run.Model.SetPaused(false);
+            for (int tick = 0; tick < maxSeconds * 8 && !run.VictoryExitOpen && session.Battle.Phase == BattlePhase.Fighting; tick++)
+                run.Tick(.125);
+            row.Outcome = run.VictoryExitOpen ? "SideAWin" : session.Battle.Report?.Outcome.ToString() ?? "Timeout";
+            row.Won = row.Outcome == "SideAWin";
+            row.Timeout = row.Outcome is "Timeout" or "RoundLimit";
+            row.Seconds = run.Model.Elapsed;
+            row.AllyDeaths = allies.Count(unit => unit.InstantDead);
+            row.EnemyDeaths = enemies.Count(unit => unit.InstantDead);
+            row.AllyDown = allies.Count(unit => !unit.InstantDead && unit.KnockedDown);
+            row.EnemyDown = enemies.Count(unit => !unit.InstantDead && unit.KnockedDown);
+            foreach (var attack in run.RpgAttackHistory)
+            {
+                var source = session.Battle.Soldier(attack.SourceId - 1);
+                if (source?.ProfessionKind != SoldierKind.Mage) continue;
+                if (source.Side == BattleSide.B)
+                {
+                    row.EnemySplashHits += attack.SplashTargetsHit;
+                    row.EnemySplashDamage += attack.SplashDamageApplied;
+                    continue;
+                }
+                if (attack.ImpactApplied) row.DirectMageDamage += attack.DamageApplied;
+                if (attack.SplashTargetsHit > 0) row.SplashCasts++;
+                row.SplashHits += attack.SplashTargetsHit;
+                row.SplashDamage += attack.SplashDamageApplied;
+            }
+            return row;
+        }
+
+        private static void WriteMageSplashSummary(TextWriter output, MageSplashResult[] baseline,
+            MageSplashResult[] variant, bool pin)
+        {
+            var changed = variant[0];
+            var pairs = baseline.Zip(variant, (before, after) => (before, after)).ToArray();
+            bool noLegalSecondaryTargets = MageSplashSpread(changed.Scene) ||
+                changed.Scene.StartsWith("captain", StringComparison.Ordinal);
+            if (pairs.Any(pair => pair.before.Seed != pair.after.Seed || pair.before.Fixture != pair.after.Fixture ||
+                pair.before.SplashHits != 0 || pair.before.SplashDamage != 0 || pair.before.EnemySplashHits != 0 ||
+                (noLegalSecondaryTargets || changed.Index == 0 && pair.after.EnemyMages == 0) &&
+                    (pair.after.SplashHits != 0 || pair.after.SplashDamage != 0 || pair.after.EnemySplashHits != 0 ||
+                    pair.before.Outcome != pair.after.Outcome || pair.before.Seconds != pair.after.Seconds ||
+                    !pair.before.FirstEnemyDown.Equals(pair.after.FirstEnemyDown) ||
+                    pair.before.AllyDeaths != pair.after.AllyDeaths || pair.before.EnemyDeaths != pair.after.EnemyDeaths)))
+                throw new InvalidOperationException("mage splash comparison changed a controlled or ineligible fixture");
+            if (MageSplashClustered(changed.Scene) && changed.Index > 0 && variant.Sum(row => row.SplashHits) == 0)
+                throw new InvalidOperationException("the clustered formation never exercised a real splash impact");
+
+            var firstPairs = pairs.Where(pair => !double.IsNaN(pair.before.FirstEnemyDown) && !double.IsNaN(pair.after.FirstEnemyDown)).ToArray();
+            double first = firstPairs.Length == 0 ? double.NaN : firstPairs.Average(pair => pair.after.FirstEnemyDown - pair.before.FirstEnemyDown);
+            double end = pairs.Average(pair => pair.after.Seconds - pair.before.Seconds);
+            double deaths = pairs.Average(pair => pair.after.AllyDeaths - pair.before.AllyDeaths);
+            double Total(Func<MageSplashResult, double> select) => variant.Sum(select);
+            string FirstMean(MageSplashResult[] rows) => OptionalSplashNumber(rows.Where(row => !double.IsNaN(row.FirstEnemyDown))
+                .Select(row => row.FirstEnemyDown).DefaultIfEmpty(double.NaN).Average());
+
+            int winsBefore = baseline.Count(row => row.Won), winsAfter = variant.Count(row => row.Won);
+            output.WriteLine(MageCsv(changed.Scene, changed.Grade, MageRoleComposition[changed.Index], changed.Index * 2,
+                pin ? 1 : 0, pairs.Length, winsBefore, winsAfter, winsAfter - winsBefore,
+                pairs.Count(pair => !pair.before.Won && pair.after.Won), pairs.Count(pair => pair.before.Won && !pair.after.Won),
+                baseline.Count(row => row.Timeout), variant.Count(row => row.Timeout), firstPairs.Length, OptionalSplashNumber(first),
+                FirstMean(baseline), FirstMean(variant), end, baseline.Average(row => row.Seconds), variant.Average(row => row.Seconds),
+                deaths, baseline.Average(row => row.AllyDeaths), variant.Average(row => row.AllyDeaths),
+                pairs.Average(pair => pair.after.EnemyDeaths - pair.before.EnemyDeaths), variant.Count(row => row.SplashHits > 0),
+                Total(row => row.SplashCasts), Total(row => row.SplashHits), Total(row => row.SplashDamage),
+                Total(row => row.EnemySplashHits), Total(row => row.EnemySplashDamage)));
+            Debug.Log($"[MageSplashOutcome] {changed.Scene} grade={changed.Grade} mages={changed.Index * 2} wins={winsBefore}/{pairs.Length}->{winsAfter}/{pairs.Length} firstDownDelta={first:F2} endDelta={end:F2} allyDeathDelta={deaths:F2} splashHits={Total(row => row.SplashHits):F0} splashHp={Total(row => row.SplashDamage):F1}");
+        }
+
+        private static string OptionalSplashNumber(double number) => double.IsNaN(number) ? "" : number.ToString("R", Invariant);
+    }
+}
