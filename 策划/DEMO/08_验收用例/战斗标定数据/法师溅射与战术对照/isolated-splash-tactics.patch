+                "board edges do not wrap, allies and knocked-down targets are skipped");
+            Debug.Log("[MageSplashRules] board edge, allied cell, knocked-down cell and no wrap PASS");
+        }
+
+        private static void VerifyMageSplashObstacles(int seed, bool cliff)
+        {
+            var (run, mage, enemies) = MageSplashMatch(seed, 3);
+            run.MageSplashEnabled = true;
+            SetMageSplashPosition(run, mage, 3.75, 4.75);
