+                int lane = trial.Case == "bow" && trial.Position == "exposed" ? 8 : 5;
+                Captain(1, 1, 3, lane, SquadStrategy.Protect);
+                foreach (int z in new[] { lane - 1, lane, lane + 1 }) Troop(1, 1, 2, z);
+            }
+            return placements;
+        }
+
+        private static GridPosition TacticsCell(BattleSide side, int x, int z) =>
+            new GridPosition(side == BattleSide.A ? x : TacticsWidth - 1 - x, z);
+
+        private static void InstallTacticsRoster(BaseCampaignBattle opening, RpgRules rules, BattleSide side,
+            List<TacticsPlacement> placements, int grade)
+        {
+            var army = opening.Scenario.Army(side);
+            var counts = Enumerable.Range(0, 4).Select(p => placements.Count(c => c.Kind == BaseRpg.Kind(p))).ToArray();
+            var normals = Normals(rules, counts, grade).GroupBy(m => m.Kind)
+                .ToDictionary(group => group.Key, group => new Queue<BaseEnemyMember>(group));
+            var captains = placements.Where(x => x.Kind == SoldierKind.Hero).ToArray();
+            army.HeroCount = captains.Length;
+            army.CaptainSlot = captains.Length == 0 ? -1 : 0;
+            army.Capacity = 90;
+            foreach (SoldierKind kind in BattleSimulation.TroopKinds)
+                army.SetCount(kind, placements.Count(x => x.Kind == kind));
+
+            foreach (var place in captains)
+            {
+                var command = new CommanderLoadout { Strategy = place.Strategy };
+                foreach (SoldierKind kind in BattleSimulation.TroopKinds)
+                    command.Set(kind, placements.Count(x => x.Slot == place.Slot && x.Kind == kind));
+                army.Commanders.Add(command);
+                string id = "tactics:" + side + ":captain:" + place.Slot;
+                var profile = BaseRpg.Character(id, place.Profession, false, false, rules);
+                var stats = rules.Bare(profile, 1);
+                var gear = new BasePersonalLoadout { Version = 1, InitialWeapon = BaseRpg.Weapon(place.Profession),
+                    Weapon = BaseRpg.Weapon(place.Profession), BaseStats = stats.Clone() };
+                army.CommanderNames.Add(id);
+                army.CommanderStats.Add(stats.Clone());
+                if (side == BattleSide.A)
+                    opening.Leaders.Add(new BaseLeader { Id = id, Name = id, Rpg = profile, PersonalEquipment = gear,
+                        Health = stats.Health, MaxHealth = stats.Health, HasCombatProfile = true,
+                        CombatStats = stats.Clone(), Training = BaseTraining.FromProfile(stats) });
+                else
+                    opening.Enemies.Add(new BaseEnemyMember { Id = id, Name = id, Rpg = profile,
+                        Kind = SoldierKind.Hero, CommanderSlot = place.Slot, Stats = stats.Clone(),
+                        Health = stats.Health, Equipment = gear });
+            }
+
+            foreach (var place in placements)
+            {
+                GridPosition cell = TacticsCell(side, place.X, place.Z);
+                if (!opening.Scenario.Board.Walkable(cell) || opening.Scenario.Board.Cell(cell).Zone !=
+                    (side == BattleSide.A ? DeploymentZone.A : DeploymentZone.B))
+                    throw new InvalidOperationException($"Invalid deployment side={side} cell={cell}");
+                opening.Scenario.Placements.Add(new UnitPlacement { Cell = cell, Side = side, Kind = place.Kind,
+                    CommanderSlot = place.Slot });
+                if (place.Kind == SoldierKind.Hero) continue;
+                var troop = normals[place.Kind].Dequeue();
+                troop.CommanderSlot = place.Slot;
+                if (side == BattleSide.B) opening.Enemies.Add(troop);
+                else
+                {
+                    opening.Troops.Add(new BaseWorkerBucket { Kind = BaseCampaign.ToBase(place.Kind), Count = 1,
+                        TemplateId = troop.Rpg.TemplateId, HasCombatProfile = true,
+                        CombatStats = troop.EffectiveStats(rules), Health = troop.Health, MaxHealth = troop.Stats.Health,
+                        SoldierNumbers = new List<int> { opening.Troops.Count + 1 } });
+                    opening.TroopSlots.Add(place.Slot);
+                }
+            }
+        }
+
+        private static RealtimeCampaignBattle StartTactics(TacticsTrial trial, RpgRules rules, int grade)
+        {
+            bool duel = trial.Case == "duel";
+            var board = BattleBoard.CreateDefault(TacticsWidth, TacticsHeight);
+            int deployThrough = duel ? 8 : 6;
+            foreach (var point in board.Positions())
+            {
+                var cell = board.Cell(point);
+                cell.Zone = point.Z > 0 && point.Z < TacticsHeight - 1
+                    ? point.X > 0 && point.X <= deployThrough ? DeploymentZone.A :
+                        point.X >= TacticsWidth - 1 - deployThrough && point.X < TacticsWidth - 1 ? DeploymentZone.B :
+                        DeploymentZone.None : DeploymentZone.None;
+                if (!duel && point.X >= 7 && point.X <= 10)
+                {
+                    if (trial.Map == "guarded" && point.Z <= 7)
+                        // A one-tile muddy center crossing and an open flank at Z >= 8 are available to either army.
+                        cell.Terrain = point.Z == 5 ? TerrainKind.Swamp : TerrainKind.Wall;
+                    else if (point.Z == 7) cell.Terrain = TerrainKind.Wall;
+                }
+            }
+            var scenario = new BattleScenario { Board = board, MaxRounds = 90, StalemateRounds = 90,
+                CommanderControl = true, MobileBattleRules = true, IndependentArmyA = duel, IndependentArmyB = duel,
+                FogEnabled = false, PlayerLeaderSlot = -1, CustomExits = true, CampaignRules = true,
+                TestAutoDeployment = false, RandomSeed = trial.Seed,
+                ExitA = new GridPosition(0, 5), ExitB = new GridPosition(TacticsWidth - 1, 5) };
+            var opening = new BaseCampaignBattle { Id = "tactics:" + trial.Seed, EventId = "tactics:" + trial.Case,
+                Rpg = rules, Scenario = scenario, RealtimeRules = true, RealtimeRulesVersion = 1, StartedDay = 1,
+                TroopSlots = new List<int>() };
+            var subject = trial.Mirror ? BattleSide.B : BattleSide.A;
+            InstallTacticsRoster(opening, rules, BattleSide.A, TacticsRoster(trial, subject == BattleSide.A), grade);
+            InstallTacticsRoster(opening, rules, BattleSide.B, TacticsRoster(trial, subject == BattleSide.B), grade);
+
+            var session = new BaseCampaignSession(opening);
+            var actual = session.Battle.Soldiers;
+            if (actual.Count != scenario.Placements.Count || scenario.Placements.Any(p =>
+                !actual.Any(u => u.Side == p.Side && u.Kind == p.Kind && u.Cell == p.Cell &&
+                    u.OriginCommanderSlot == p.CommanderSlot)))
+                throw new InvalidOperationException("A fixture placement was rejected or repositioned: " + trial.Case);
+            session.Bind();
+            if (!session.Battle.Start(out string problem)) throw new InvalidOperationException(problem);
+
+            var run = new RealtimeCampaignBattle(session, "normal");
+            run.Model.SwordContactPinEnabled = trial.Pin;
+            run.Model.BothSidesHuman = true;
+            run.OutcomeResolver = battle =>
+            {
+                bool ally = battle.Model.Units.Any(u => u.Alive && u.Side == PrototypeSide.Ally);
+                bool enemy = battle.Model.Units.Any(u => u.Alive && u.Side == PrototypeSide.Enemy);
+                if (!ally || !enemy) return ally ? BattleOutcome.SideAWin : enemy ? BattleOutcome.SideBWin : BattleOutcome.Draw;
+                return battle.Model.Elapsed + 1e-8 >= scenario.MaxRounds ? BattleOutcome.RoundLimit : BattleOutcome.None;
+            };
+            foreach (var captain in run.Model.Units.Where(u => u.Role == PrototypeRole.Leader))
+                run.SetDuelManualSkills((BattleSide)(int)captain.Side, captain.Squad);
+            run.Model.SetPaused(false);
+            return run;
+        }
+
+        private static bool IssueTactics(RealtimeCampaignBattle run, PrototypeUnit captain, PrototypeOrder order,
+            PrototypePoint point, PrototypeUnit target = null)
+        {
+            if (captain?.Alive != true || order == PrototypeOrder.Focus && target?.Alive != true) return false;
+            if (captain.Side == PrototypeSide.Ally)
+                return run.Issue(new[] { captain.Id - 1 }, order, point, target == null ? -1 : target.Id - 1,
+                    squadFocus: order == PrototypeOrder.Focus);
+            // Opposite-start trials go through the same orders used by a live guest captain.
+            int targetId = target?.Id ?? -1;
+            if (target != null && !run.Battle.PlayerCanSee(BattleSide.B, run.Battle.Soldier(target.Id - 1))) return false;
+            if (!run.Model.IssueOrder(-1, captain.Id, order, point, targetId, side: captain.Side)) return false;
+            run.Model.MarkDirectOrder(new[] { captain.Squad }, order, targetId, order == PrototypeOrder.Focus, captain.Side);
+            return true;
+        }
+
+        private static TacticsObservation ObserveTactics(TacticsTrial trial, RpgRules rules, int grade)
+        {
+            var run = StartTactics(trial, rules, grade);
+            var ownSide = trial.Mirror ? PrototypeSide.Enemy : PrototypeSide.Ally;
+            var own = run.Model.Units.Where(u => u.Side == ownSide).ToArray();
+            var opponent = run.Model.Units.Where(u => u.Side != ownSide).ToArray();
+            var byId = run.Model.Units.ToDictionary(u => u.Id);
+            BattleSoldier Soldier(PrototypeUnit unit) => run.Battle.Soldier(unit.Id - 1);
+            SoldierKind Role(PrototypeUnit unit) => Soldier(unit).ProfessionKind;
+            string PointList(IEnumerable<PrototypeUnit> units) => string.Join("|",
+                units.Select(u => FormattableString.Invariant($"{Role(u)}@{u.Position.X:F2}:{u.Position.Z:F2}")));
+            string StatsList(IEnumerable<PrototypeUnit> units) => string.Join("|", units.Select(u =>
+            {
+                var s = Soldier(u);
+                return FormattableString.Invariant($"{s.Kind}:{s.ProfessionKind}:{s.OriginCommanderSlot}:{s.Stats.Health:R}:{s.Stats.Damage:R}:{s.Stats.Defense:R}:{s.Stats.Level}:{u.Reach:R}:{u.Speed:R}:{u.AttackInterval:R}:{(int)u.Strategy}");
+            }).OrderBy(item => item, StringComparer.Ordinal));
+            string roster = StatsList(own) + "/" + StatsList(opponent);
+            string spawns = PointList(own) + "," + PointList(opponent);
+            // Command the assigned riders against the same rear archer, or assign the same enemy rider to the bow squad.
+            var captain = own.FirstOrDefault(u => u.Squad == 1 && u.Role == PrototypeRole.Leader);
+            var target = opponent.FirstOrDefault(u => u.Role != PrototypeRole.Leader &&
+                Role(u) == (trial.Case == "cavalry" ? SoldierKind.Ranged : SoldierKind.Cavalry));
+            int focusOrders = 0, moveOrders = 0;
+            int guardOrders = 0;
+            double stagedOrderTime = -1;
+            bool stageReached = false;
+            var stageCell = TacticsCell((BattleSide)(int)ownSide, 8, 8);
+            var stage = new PrototypePoint(stageCell.X + .25, stageCell.Z + .25);
+            if (trial.Map == "guarded")
+            {
+                // The same sword screen guards in both layouts and both command arms.
+                var screen = (trial.Case == "bow" ? own : opponent)
+                    .Single(u => u.Squad == 0 && u.Role == PrototypeRole.Leader);
+                if (!IssueTactics(run, screen, PrototypeOrder.Guard, screen.Position))
+                    throw new InvalidOperationException("Sword screen guard order rejected");
+                guardOrders++;
+            }
+            if (trial.Command == "staged")
+            {
+                if (!IssueTactics(run, captain, PrototypeOrder.Move, stage))
+                    throw new InvalidOperationException("Staged cavalry move rejected");
+                moveOrders++;
+            }
+            else if (trial.Command == "direct" || trial.Command == "focus")
+            {
+                if (!IssueTactics(run, captain, PrototypeOrder.Focus, target.Position, target))
+                    throw new InvalidOperationException("Captain squad focus rejected");
+                focusOrders++;
+            }
+
+            double ownContact = -1, oppContact = -1, rearContact = -1;
+            bool Engaged(PrototypeUnit source, Func<PrototypeUnit, bool> filter)
+            {
+                if (!source.Alive || source.Ranged || !byId.TryGetValue(source.TargetId, out var victim) ||
+                    !victim.Alive || victim.Side == source.Side || !filter(victim)) return false;
+                return (run.Model.CanTarget?.Invoke(source, victim) ?? true) &&
+                    run.Model.InAttackRadius(source, victim) && run.Model.ClearAttack(source.Position, victim.BodyCenter);
+            }
+            bool OrdinaryBow(PrototypeUnit unit) => Soldier(unit).Kind == SoldierKind.Ranged;
+            bool OrdinaryRider(PrototypeUnit unit) => Soldier(unit).Kind == SoldierKind.Cavalry;
+            var attackingRiders = (trial.Case == "bow" ? opponent : own).Where(OrdinaryRider).ToArray();
+            for (int frame = 0; frame < 90 * 8 && run.Battle.Phase == BattlePhase.Fighting; frame++)
+            {
+                run.Tick(.125);
+                double elapsed = run.Model.Elapsed;
+                if (ownContact < 0 && own.Any(u => Engaged(u, _ => true))) ownContact = elapsed;
+                if (oppContact < 0 && opponent.Any(u => Engaged(u, _ => true))) oppContact = elapsed;
+                if (rearContact < 0 && attackingRiders.Any(u => Engaged(u, OrdinaryBow))) rearContact = elapsed;
+                if (trial.Command == "staged" && focusOrders == 0 && captain.Alive && target.Alive)
+                {
+                    stageReached |= (captain.Position - stage).Length <= 1;
+                    if ((stageReached || elapsed >= 7) && IssueTactics(run, captain, PrototypeOrder.Focus, target.Position, target))
+                    {
+                        focusOrders++;
+                        stagedOrderTime = elapsed;
+                    }
+                }
+            }
+
+            var outcome = run.Battle.Report?.Outcome;
+            string result = outcome is BattleOutcome.SideAWin or BattleOutcome.SideBWin
+                ? ((outcome == BattleOutcome.SideAWin) == !trial.Mirror ? "own" : "opp")
+                : outcome?.ToString() ?? "timeout";
+            var attacks = run.RpgAttackHistory.Where(p => p.TargetId > 0 && byId.ContainsKey(p.SourceId) &&
+                byId.ContainsKey(p.TargetId)).ToArray();
+            var damage = attacks.Where(p => p.ImpactApplied && p.DamageApplied > 0)
+                .OrderBy(p => p.ArriveAt).ThenBy(p => p.Id).ToArray();
+            var firstLaunch = attacks.FirstOrDefault();
+            var firstHit = damage.FirstOrDefault();
+            var rearHits = damage.Where(p => attackingRiders.Contains(byId[p.SourceId]) &&
+                OrdinaryBow(byId[p.TargetId])).ToArray();
+            var focusHit = damage.FirstOrDefault(p => target != null && p.TargetId == target.Id &&
+                byId[p.SourceId].Side == ownSide && byId[p.SourceId].Squad == 1);
+            var pressureShots = attacks.Count(p => OrdinaryBow(byId[p.SourceId]) &&
+                (p.Context & RpgShotContext.MeleePressure) != 0);
+            string SourceSide(RpgAttackPacket packet) => packet == null ? "none" :
+                byId[packet.SourceId].Side == ownSide ? "own" : "opp";
+            string SourceKind(RpgAttackPacket packet) => packet == null ? "none" : Role(byId[packet.SourceId]).ToString();
+            double Loss(IEnumerable<PrototypeUnit> units) => 100 * units.Sum(u => u.MaxHealth - Math.Max(0, u.Health)) /
+                units.Sum(u => u.MaxHealth);
+            double Pin(IEnumerable<PrototypeUnit> units) => units.Sum(run.Model.SwordContactPinnedSeconds);
+            int BowDown(IEnumerable<PrototypeUnit> units) => units.Count(u => OrdinaryBow(u) && !u.Alive);
+            var values = new object[] { trial.Case, trial.Position, trial.Command, trial.Pin ? 1 : 0, trial.Seed,
+                trial.Mirror ? 1 : 0, grade, result, run.Model.Elapsed, own.Length, opponent.Length, Loss(own),
+                Loss(opponent), own.Count(u => !u.Alive), opponent.Count(u => !u.Alive), SourceSide(firstLaunch),
+                SourceKind(firstLaunch), firstLaunch?.LaunchedAt ?? -1, SourceSide(firstHit), SourceKind(firstHit),
+                firstHit?.ArriveAt ?? -1, ownContact, oppContact, rearContact, rearHits.FirstOrDefault()?.ArriveAt ?? -1,
+                rearHits.Length, rearHits.Sum(p => p.DamageApplied), pressureShots, BowDown(own), BowDown(opponent),
+                Pin(own), Pin(opponent), Pin(own.Where(OrdinaryRider)), Pin(opponent.Where(OrdinaryRider)),
+                own.Where(OrdinaryRider).Sum(u => u.DistanceTravelled), opponent.Where(OrdinaryRider).Sum(u => u.DistanceTravelled),
+                run.Model.ShoveMoves, focusOrders, moveOrders, stageReached ? 1 : 0, stagedOrderTime, focusHit?.ArriveAt ?? -1,
+                spawns, trial.Map, guardOrders };
+            return new TacticsObservation { Row = string.Join(",", values.Select(v => Convert.ToString(v, Invariant))),
+                Roster = roster, FocusOrders = focusOrders, MoveOrders = moveOrders };
+        }
+    }
+}
