+        private static void VerifyActiveSplashHeight()
+        {
+            var run = TerrainMatch(TerrainFixture.RampEastWest, new PrototypePoint(10.25, 4.25),
+                new PrototypePoint(6.75, 4.25), mage: true);
+            var caster = Archer(run);
