+            Debug.Log($"[MageSplashRules] {(cliff ? "orthogonal cliff" : "diagonal wall corner")} PASS");
+        }
+
+        private static void VerifyMageSplashInFlight(int hitSeed, int missSeed)
+        {
+            foreach (string variant in new[] { "moved", "miss", "down", "physical" })
+            {
+                var (run, source, enemies) = MageSplashMatch(variant == "miss" ? missSeed : hitSeed, 3,
+                    role: variant == "physical" ? 1 : 3);
+                run.MageSplashEnabled = true;
+                var target = enemies[0];
+                SetMageSplashPosition(run, source, 3.25, 4.25);
+                SetMageSplashPosition(run, target, 5.25, 4.25);
+                SetMageSplashPosition(run, enemies[1], 5.25, 4.75);
+                SetMageSplashPosition(run, enemies[2], 9.25, 4.75);
+                var packet = ReleaseTargetDiceAttack(run, source, target);
+                if (variant == "moved")
+                    SetMageSplashPosition(run, target, 9.25, 4.25);
+                if (variant == "down")
+                {
+                    target.Health = 1;
+                    target.KnockedDown = true;
+                }
+                SettleMageSplashShot(run, packet);
+
+                RequireMageSplash(packet.Hit == (variant != "miss") && packet.ImpactApplied == (variant == "moved" || variant == "physical") &&
+                    packet.MageSplashEligible == (variant != "physical") && enemies[1].Health == MageSplashTestHealth,
+                    $"{variant}: primary settlement and old impact neighbor");
+                RequireMageSplash(packet.SplashTargetsHit == (variant == "moved" ? 1 : 0) &&
+                    NearSplash(MageSplashTestHealth - enemies[2].Health, variant == "moved" ? packet.DamageApplied / 8 : 0),
+                    $"{variant}: only a successful live magic impact splashes at the target's current location");
+                Debug.Log($"[MageSplashRules] projectile {variant} hit={packet.Hit} impact={packet.ImpactApplied} splash={packet.SplashTargetsHit}");
+            }
+        }
+
+        private static bool NearSplash(double actual, double expected) => Math.Abs(actual - expected) < .001;
+
+        private static void RequireMageSplash(bool test, string message)
+        {
+            if (!test) throw new InvalidOperationException("[MageSplashRules] " + message);
+        }
+    }
+}
