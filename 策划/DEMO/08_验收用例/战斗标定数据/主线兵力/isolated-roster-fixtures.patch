+        private static BasePrepRoute RosterRoute(string id)
+        {
+            if (id.StartsWith("cave-", StringComparison.Ordinal)) return BasePrepRoute.Ruins;
+            if (id.StartsWith("hideout", StringComparison.Ordinal)) return BasePrepRoute.Hideout;
+            if (id.StartsWith("defense", StringComparison.Ordinal)) return BasePrepRoute.Defense;
+            if (id.StartsWith("blackcrow-", StringComparison.Ordinal)) return BasePrepRoute.BlackCrow;
+            if (id.StartsWith("second-", StringComparison.Ordinal)) return BasePrepRoute.Second;
+            throw new ArgumentException("unknown roster snapshot " + id);
+        }
+
+        private static IEnumerable<RosterCase> RosterCases(BaseState state, string id, BasePrepRoute route)
+        {
+            var draft = new BaseBattlePreparation(state, route);
+            int captains = draft.Units.Count(u => u.Kind == SoldierKind.Hero);
+            var ready = RosterKinds.Select(k => draft.Units.Count(u => u.Kind == k)).ToArray();
+            var sizes = route switch
+            {
+                BasePrepRoute.Ruins => new[] { 0 },
+                BasePrepRoute.Hideout => new[] { 6, 9, 10 },
+                BasePrepRoute.Defense => new[] { 6, 9, 11 },
+                BasePrepRoute.BlackCrow => new[] { ready.Sum() },
+                BasePrepRoute.Second when id.Contains("early") => new[] { 10, 11 },
+                _ => new[] { 14, 16, 18, 20 }
+            };
+            // Include the strongest legal size on this branch when the exact planned tier is unavailable.
+            int available = route == BasePrepRoute.BlackCrow ? ready.Sum() : ready.Take(3).Sum();
+            int stock = Math.Max(draft.AvailableSupply(state, 1), draft.AvailableSupply(state, 2));
+            int max = Math.Min(sizes.Max(), Math.Min(available, stock));
+            if (route != BasePrepRoute.BlackCrow && max > 0 && !sizes.Contains(max)) sizes = sizes.Append(max).OrderBy(n => n).ToArray();
+            foreach (int size in sizes)
+            {
+                int team = route == BasePrepRoute.Ruins ? captains : route == BasePrepRoute.Defense && size <= 6
+                    ? Math.Min(2, captains) : Math.Min(3, captains);
+                var counts = route == BasePrepRoute.BlackCrow ? ready : ChooseRosterCounts(size, ready);
+                if (counts == null || team < 1)
+                {
+                    Debug.Log($"[RosterUnreachable] {id} {team}+{size}, available={string.Join("/", ready)}");
+                    continue;
+                }
+                if (id == "cave-solo")
+                    yield return new RosterCase { Id = id, Source = state, Route = route, Leaders = team,
+                        Counts = counts, Grade = 0, ExitAtHalf = true };
+                bool offered = false;
+                foreach (int grade in size == 0 ? new[] { 0 } : new[] { 1, 2 })
+                {
+                    if (size > draft.AvailableSupply(state, grade)) continue;
+                    offered = true;
+                    foreach (bool guided in new[] { false, true })
+                    {
+                        yield return new RosterCase { Id = id, Source = state, Route = route, Leaders = team,
+                            Counts = counts, Grade = grade, Guided = guided };
+                        if (route != BasePrepRoute.BlackCrow && ready[3] > 0 && counts[1] > 0 && size >= 6)
+                        {
+                            var mix = (int[])counts.Clone();
+                            mix[3] = Math.Min(2, Math.Min(ready[3], mix[1]));
+                            mix[1] -= mix[3];
+                            yield return new RosterCase { Id = id, Source = state, Route = route, Leaders = team,
+                                Counts = mix, Grade = grade, Guided = guided };
+                        }
+                    }
+                }
+                if (!offered)
+                    Debug.Log($"[RosterUnreachable] {id} {team}+{size}, supplies={draft.AvailableSupply(state, 1)}/{draft.AvailableSupply(state, 2)}");
+            }
+        }
+
+        private static int[] ChooseRosterCounts(int size, int[] ready)
+        {
+            if (size > ready.Take(3).Sum()) return null;
+            var original = size switch
+            {
+                6 => new[] { 2, 2, 2, 0 },
+                9 => new[] { 4, 3, 2, 0 },
+                10 => new[] { 4, 4, 2, 0 },
+                11 => new[] { 4, 4, 3, 0 },
+                14 => new[] { 5, 5, 4, 0 },
+                _ => new[] { 0, 0, 0, 0 }
+            };
+            var counts = original.Select((n, i) => Math.Min(n, ready[i])).ToArray();
+            while (counts.Sum() < size)
+            {
+                int best = Enumerable.Range(0, 3).Where(i => counts[i] < ready[i])
+                    .OrderBy(i => (counts[i] + 1d) / (i == 2 ? .28 : .36)).ThenBy(i => i).First();
+                counts[best]++;
+            }
+            return counts;
+        }
