+                    f.Leaders, f.LeaderStats, sample.Counts[0], sample.Counts[1], sample.Counts[2], sample.Counts[3], f.Soldiers,
+                    sample.Grade, f.SupplyStock, f.Food, f.Coin, tactics, f.Seed, f.Run?.Battle.Scenario.RandomSeed,
+                    f.EnemyCount, f.EnemyLeaders, f.Orders, f.Outcome, f.Settled ? 1 : 0, f.Seconds, f.Deaths, f.Down, f.SupplyUsed, f.Issue));
+            int wins = trials.Count(t => t.Settled && t.Outcome == "SideAWin");
+            summary.WriteLine(RosterCsv(phase, sample.Id, sample.Route, trials[0].Day, trials[0].StartBatuFate, trials[0].Leaders,
+                sample.Counts[0], sample.Counts[1], sample.Counts[2], sample.Counts[3], sample.Grade, tactics,
+                wins, trials.Length, trials.Count(f => f.Outcome == "Retreat"), trials.Count(f => f.Outcome == "SideBWin"),
+                trials.Count(f => f.Outcome == "timeout"), trials.Count(f => f.Outcome == "ineligible"),
+                trials.Average(f => f.Seconds), trials.Average(f => f.Deaths), trials.Average(f => f.Down), trials.Average(f => f.SupplyUsed)));
+            raw.Flush();
+            summary.Flush();
+            Debug.Log($"[RosterResult] {phase} {sample.Id} {sample.Leaders}+{string.Join("/", sample.Counts)} L{sample.Grade} {tactics}: {wins}/{trials.Length}");
+        }
+    }
+}
diff --git a/Assets/Editor/VerifyMainBattleRosterSupplements.cs b/Assets/Editor/VerifyMainBattleRosterSupplements.cs
new file mode 100644
