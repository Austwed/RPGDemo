+        private static RosterFight PrepareRosterFight(RosterCase sample, int seed)
+        {
+            var state = sample.Source.Copy();
+            state.Demo.Rpg.GenerationSeed = seed;
+            var draft = new BaseBattlePreparation(state, sample.Route) { SupplyGrade = Math.Max(1, sample.Grade) };
+            var trial = new RosterFight { Case = sample, Seed = seed, State = state, Day = state.Day,
+                StartBatuFate = state.Demo.Defense.BatuFate, SupplyStock = draft.AvailableSupply(state, sample.Grade),
+                Food = state.Inventory.Food, Coin = state.Inventory.Coins };
+            var leads = draft.Units.Where(u => u.Kind == SoldierKind.Hero)
+                .OrderByDescending(u => u.Id == draft.PlayerId).ThenBy(u => u.Id == "partner_craft" ? 0 : 1)
+                .ThenByDescending(u => u.Health).Take(sample.Leaders).ToArray();
+            foreach (var u in draft.Units) u.Selected = leads.Contains(u);
+            BasePrepUnit riderLead = leads.FirstOrDefault(u => u.Id == "partner_craft") ?? leads.Last();
+            BasePrepUnit bowLead = leads.FirstOrDefault(u => u != riderLead && u.Id != draft.PlayerId) ?? leads[0];
+            for (int i = 0; i < RosterKinds.Length; i++)
+            {
+                var soldiers = draft.Units.Where(u => u.Kind == RosterKinds[i])
+                    .OrderByDescending(u => u.Health / u.MaxHealth).ThenBy(u => u.SoldierNumber).Take(sample.Counts[i]).ToArray();
+                foreach (var u in soldiers)
+                {
+                    u.Selected = true;
+                    u.TeamId = sample.Guided ? (i == 2 ? riderLead : i == 1 || i == 3 ? bowLead : leads[0]).Id
+                        : leads[Array.IndexOf(soldiers, u) % leads.Length].Id;
+                }
+            }
+            if (sample.Guided && sample.Route is BasePrepRoute.Defense or BasePrepRoute.Second or BasePrepRoute.BlackCrow)
+                PlaceRosterTactics(draft, leads, riderLead, bowLead, sample.Route);
+            else
+                draft.AutoPlace();
+            var deployed = draft.Units.Where(u => u.Selected && draft.Positions.ContainsKey(u.Id)).ToArray();
+            var selectedSoldiers = deployed.Where(u => u.Kind != SoldierKind.Hero).ToArray();
+            trial.Leaders = string.Join("|", leads.Select(u => u.Name));
+            trial.LeaderStats = string.Join("|", leads.Select(u =>
+            {
+                var hero = state.Leaders.First(l => l.Id == u.Id);
+                var stats = BaseCommanderIdentity.Stats(hero, new ArmyDefinition().Hero);
+                return FormattableString.Invariant($"{u.Name}:{stats.Level}:{u.Health:F1}/{u.MaxHealth:F1}:{stats.Damage:F1}:{stats.Defense:F1}");
+            }));
+            trial.Soldiers = string.Join("|", selectedSoldiers.OrderBy(u => u.SoldierNumber).Select(u =>
+                FormattableString.Invariant($"{u.Kind}:{u.SoldierNumber}:{u.Health:F1}/{u.MaxHealth:F1}")));
+            trial.Issue = draft.Problem(state, true);
+            if (trial.Issue == "" && (deployed.Length != leads.Length + sample.Counts.Sum() ||
+                !RosterKinds.Select(k => selectedSoldiers.Count(u => u.Kind == k)).SequenceEqual(sample.Counts)))
+                trial.Issue = "阵容未能按计划全部落位";
+            if (trial.Issue != "")
+            {
+                trial.Outcome = "ineligible";
+                return trial;
+            }
+            var run = (RealtimeCampaignBattle)RosterCombat.Invoke(new object[] { draft.Begin(state), "normal" });
+            run.EnableBattlefieldExits();
+            switch (sample.Route)
+            {
+                case BasePrepRoute.Ruins: BaseDemoRuins.Configure(run); break;
+                case BasePrepRoute.Defense:
+                case BasePrepRoute.Second: BaseDemoDefense.Configure(run); break;
+                case BasePrepRoute.BlackCrow: BaseDemoFinale.Configure(run); break;
+            }
+            trial.Run = run;
+            trial.EnemyCount = run.Battle.Soldiers.Count(u => u.Side == BattleSide.B && u.Kind != SoldierKind.Hero);
+            trial.EnemyLeaders = run.Battle.Soldiers.Count(u => u.Side == BattleSide.B && u.Kind == SoldierKind.Hero);
+            return trial;
+        }
+
+        private static void PlaceRosterTactics(BaseBattlePreparation draft, BasePrepUnit[] leaders, BasePrepUnit rider,
+            BasePrepUnit bowLead, BasePrepRoute route)
+        {
+            var zone = draft.Board.Positions().Where(c => draft.Board.Walkable(c) && draft.Board.Cell(c).Zone == DeploymentZone.A).ToArray();
+            if (zone.Length == 0) return;
+            // Use actual deployment tiles and the incoming side, so maps work in either orientation.
+            var hostile = draft.Board.Positions().Where(c => draft.Board.Cell(c).Zone == DeploymentZone.B).ToArray();
+            var fallback = (route == BasePrepRoute.BlackCrow) ? draft.Board.Width - 1 : 0;
+            double attackX = hostile.Length == 0 ? fallback : hostile.Average(c => c.X);
+            double attackZ = hostile.Length == 0 ? zone.Average(c => c.Z) : hostile.Average(c => c.Z);
+            double middleZ = zone.Average(c => c.Z);
+            double Depth(GridPosition p) => Math.Abs(p.X - attackX) + .25 * Math.Abs(p.Z - attackZ);
+            var front = zone.OrderBy(Depth).ThenBy(p => Math.Abs(p.Z - middleZ)).ToArray();
+            var rear = zone.OrderByDescending(Depth).ThenBy(p => Math.Abs(p.Z - middleZ)).ToArray();
+            var flank = zone.OrderByDescending(p => Math.Abs(p.Z - middleZ)).ThenBy(Depth).ToArray();
+            void Place(BasePrepUnit unit, IEnumerable<GridPosition> cells)
+            {
+                foreach (var cell in cells) if (draft.Place(unit.Id, cell)) return;
+            }
+            foreach (var leader in leaders)
+                Place(leader, leader == rider && route == BasePrepRoute.BlackCrow ? flank :
+                    leader == bowLead && leader != leaders[0] ? rear : front);
+            foreach (var unit in draft.Units.Where(u => u.Selected && u.Kind == SoldierKind.Melee))
+                Place(unit, front);
+            foreach (var unit in draft.Units.Where(u => u.Selected && u.Kind != SoldierKind.Hero && u.Kind != SoldierKind.Melee))
+                Place(unit, unit.Kind == SoldierKind.Cavalry && route == BasePrepRoute.BlackCrow ? flank :
+                    unit.Kind == SoldierKind.Cavalry ? front : rear);
+            draft.AutoPlace();
+        }
