+        private static string RosterCsv(params object[] fields) => string.Join(",", fields.Select(value =>
+        {
+            string field = Convert.ToString(value, RosterCulture) ?? "";
+            return field.IndexOfAny(new[] { ',', '"', '\n', '\r' }) < 0 ? field : "\"" + field.Replace("\"", "\"\"") + "\"";
+        }));
