+++ b/Assets/Editor/VerifyMainBattleRosterSupplements.cs
@@ -0,0 +1,215 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using BaseConquest.Base;
+using BaseConquest.Battle;
+using UnityEditor;
+using UnityEngine;
+
+namespace BaseConquest.Editor
+{
+    public static partial class VerifyDemoPlayerRoute
+    {
+        private const string RosterSupplementHeader = "id,file,route,day,batu,leaders,sword,bow,cavalry,mage,eligible_soldiers,l1,l2,food,materials,coins,notes";
+
+        public static void VerifyMainBattleRosterOrdinaryMage() => RunRosterSupplement("mage-side",
+            new[] { "blackcrow-mage", "second-restocked-mage-escaped", "second-restocked-mage-dead" },
+            RecordRosterMageSide);
+
+        public static void VerifyMainBattleRosterMarchSizes() => RunRosterSupplement("march-sizes",
+            new[] { "blackcrow-restocked-12", "blackcrow-restocked-13" }, RecordExactMarchSizes);
+
+        private static void RunRosterSupplement(string label, IEnumerable<string> ids, Action<Dictionary<string, string>> record)
+        {
+            const string difficulty = "BaseConquest.GlobalDifficulty";
+            bool hadDifficulty = PlayerPrefs.HasKey(difficulty);
+            string previousDifficulty = PlayerPrefs.GetString(difficulty);
+            var previousFacing = BaseInteraction.Facing;
+            int exitCode = 0;
+            Report.Clear();
+            Directory.CreateDirectory(RosterFixtureFolder);
+            foreach (string key in ids)
+                File.Delete(Path.Combine(RosterFixtureFolder, key + ".json"));
+            string indexPath = Path.Combine(RosterFixtureFolder, "index-" + label + ".csv");
+            File.Delete(indexPath);
+            try
+            {
+                PlayerPrefs.SetString(difficulty, "normal");
+                var index = new Dictionary<string, string>();
+                record(index);
+                File.WriteAllLines(indexPath, new[] { RosterSupplementHeader }.Concat(index.Values));
+            }
+            catch (Exception error)
+            {
+                exitCode = 2;
+                Note("FAIL：" + error.Message);
+                Debug.LogException(error);
+            }
+            finally
+            {
+                if (hadDifficulty) PlayerPrefs.SetString(difficulty, previousDifficulty);
+                else PlayerPrefs.DeleteKey(difficulty);
+                BaseInteraction.Facing = previousFacing;
+                File.WriteAllLines(Path.Combine(RosterFixtureFolder, "audit-" + label + ".txt"), Report);
+            }
+            EditorApplication.Exit(exitCode);
+        }
+
+        private static BaseState ReadRosterSupplementSource(string id)
+        {
+            string path = Path.Combine(RosterFixtureFolder, id + ".json");
+            var state = JsonUtility.FromJson<BaseState>(File.ReadAllText(path));
+            BaseEconomy.Validate(state);
+            return state;
+        }
+
+        private static void RecordRosterMageSide(Dictionary<string, string> index)
+        {
+            var state = ReadRosterSupplementSource("hideout");
+            Need(state.Demo.RuinsDay > 0 && state.Demo.DeliveredDay > 0 && !BaseDemoDefense.Due(state) &&
+                !state.Workers.Any(worker => worker.Kind == BaseTroopKind.Mage), "原样本不在古窟首通后的无普通法师备战期");
+            Note($"从第 {state.Day} 天原始窝点备战样本分支，前往沉眠古窟重打。配表 {state.Demo.ConfigHash}。");
+            RecruitOrdinaryMageFromRepeatCave(state);
+            Travel(state, "demo_ruins_return", "town");
+            Travel(state, "travel_base", "base");
+            RepairAndAssign(state);
+            while (!BaseDemoDefense.Due(state)) Rest(state);
+            Need(BattleReadyRecruitedMages(state) > 0, "至首防仍没有恢复到可出征阈值的普通法师");
+            EnterDefenseField(state);
+
+            var branches = new Dictionary<string, BaseState>();
+            TryRosterBranch("加入普通法师后首防结束追击", () => RecordDefenseBranch(state.Copy(), false, branches));
+            if (branches.Count == 0)
+                TryRosterBranch("加入普通法师后首防追击巴图", () => RecordDefenseBranch(state.Copy(), true, branches));
+            Need(branches.Count > 0, "招降普通法师的分支无法完成首防");
+            var after = branches.Values.First();
+            TryRosterBranch("普通法师攻寨", () =>
+            {
+                var blackcrow = after.Copy();
+                Rest(blackcrow);
+                RestockCampaignRoster(blackcrow, 13, false);
+                MarchRosterToBlackCrow(blackcrow, 14);
+                RequireRosterMage(blackcrow, BasePrepRoute.BlackCrow);
+                SaveRosterFixture(blackcrow, "blackcrow-mage", BasePrepRoute.BlackCrow, index);
+            });
+            TryRosterBranch("普通法师迎击第二波", () =>
+            {
+                var second = after.Copy();
+                while (!BaseDemoDefense.SecondDue(second))
+                {
+                    RestockCampaignRoster(second, 19, true);
+                    Rest(second);
+                }
+                EnterDefenseField(second);
+                RequireRosterMage(second, BasePrepRoute.Second);
+                SaveRosterFixture(second, "second-restocked-mage-" + second.Demo.Defense.BatuFate, BasePrepRoute.Second, index);
+            });
+            Need(index.Count > 0, "普通法师没有进入任何正式战斗备战样本");
+            Note("PASS：实战俘获的普通法师进入正式备战名册，原有 11 份样本无需重建。");
+        }
+
+        private static void RecordExactMarchSizes(Dictionary<string, string> index)
+        {
+            var defense = ReadRosterSupplementSource("defense");
+            var branches = new Dictionary<string, BaseState>();
+            RecordDefenseBranch(defense.Copy(), false, branches);
+            var replenished = branches.Values.Single();
+            Rest(replenished);
+            RestockCampaignRoster(replenished, 14, false);
+            BuyMarchSupply(replenished);
+            At(replenished, "demo_march_exit");
+            BaseDemoFinale.OpenWorld(replenished);
+            BaseAdventure.RecallPaused(replenished);
+            foreach (int bow in new[] { 4, 5 })
+            {
+                var march = replenished.Copy();
+                int[] desired = { 5, bow, 3, 0 };
+                int size = desired.Sum();
+                var draft = ExactMarchDraft(march, desired);
+                var journey = BaseWorldJourney.Plan(march, null, "bandit", "camp_entry");
+                Need(journey.Reachable && journey.Days == 1, "黑鸦寨没有一日可达的正式路线");
+                int day = march.Day;
+                int food = march.Inventory.Food;
+                BaseWorldJourney.Depart(march, "camp_entry", journey.Path, draft, false);
+                int prepaid = food - march.Inventory.Food;
+                Need(BaseWorldJourney.Step(march, _ => null) && march.Day == day + 1, "行军未结算");
+                BaseWorldJourney.EnterScene(march, "bandit_entry");
+                At(march, "demo_camp_attack");
+                var arrived = new BaseBattlePreparation(march, BasePrepRoute.BlackCrow);
+                var ids = draft.Units.Where(unit => unit.Selected && unit.Kind != SoldierKind.Hero)
+                    .Select(unit => unit.SoldierNumber).OrderBy(number => number).ToArray();
+                Need(arrived.Units.Where(unit => unit.Kind != SoldierKind.Hero).Select(unit => unit.SoldierNumber)
+                    .OrderBy(number => number).SequenceEqual(ids), "到达后的实际士兵编号与出征不一致");
+                Need(arrived.AvailableSupply(march, 1) >= size, "抵达后一级军需不足");
+                Note($"第 {day} 天以剑/弓/骑 {desired[0]}/{desired[1]}/{desired[2]} 出征，预扣路粮 {prepaid}，" +
+                    $"第 {march.Day} 天抵达，士兵编号 {string.Join("/", ids)}。");
+                SaveRosterFixture(march, "blackcrow-restocked-" + size, BasePrepRoute.BlackCrow, index);
+            }
+            Need(index.Count == 2, "12人与13人出征样本未齐全");
+            Note("PASS：两种精确兵力均从同一补员后状态正式行军抵达黑鸦寨。");
+        }
+
+        private static BaseBattlePreparation ExactMarchDraft(BaseState state, int[] desired)
+        {
+            var draft = new BaseBattlePreparation(state, BasePrepRoute.Travel);
+            var captains = draft.Units.Where(unit => unit.Kind == SoldierKind.Hero).Take(BaseAdventure.Capacity).ToArray();
+            Need(captains.Length == 3 && captains.Any(unit => unit.Id == draft.PlayerId), "补员分支缺少三名队长");
+            foreach (var unit in draft.Units) unit.Selected = captains.Contains(unit);
+            int pickIndex = 0;
+            for (int kind = 0; kind < RosterKinds.Length; kind++)
+            {
+                var soldiers = draft.Units.Where(unit => unit.Kind == RosterKinds[kind])
+                    .OrderByDescending(unit => unit.Health / unit.MaxHealth).ThenBy(unit => unit.SoldierNumber)
+                    .Take(desired[kind]).ToArray();
+                Need(soldiers.Length == desired[kind], "抵达前未能凑齐目标兵种：" + RosterKinds[kind]);
+                foreach (var soldier in soldiers)
+                {
+                    soldier.Selected = true;
+                    soldier.TeamId = captains[pickIndex++ % captains.Length].Id;
+                }
+            }
+            Need(draft.Problem(state, false) == "", "出征阵容未通过验证：" + draft.Problem(state, false));
+            return draft;
+        }
+
+        private static void RecruitOrdinaryMageFromRepeatCave(BaseState state)
+        {
+            for (int attempt = 1; attempt <= 3; attempt++)
+            {
+                At(state, "demo_ruins_investigate");
+                var run = OpenProgressionBattle(state, BasePrepRoute.Ruins, 4);
+                Need(!run.Session.Opening.RuinsFirstClear && run.Battle.Soldiers.Count(unit =>
+                    unit.Side == BattleSide.B && unit.Kind == SoldierKind.Mage) == 2, "古窟重打缺少两名普通法师");
+                ApproachController(run, true, 5400);
+                Need(BaseDemoRuins.Complete(state, run), $"第 {attempt} 次古窟重打未完成胜利离场：{run.Battle.Report?.Outcome}");
+                var captives = state.Aftermath.Prisoners.Where(person => person.BattleId == run.Session.Opening.Id &&
+                    person.Kind == SoldierKind.Mage && person.Status == "held").ToArray();
+                Note($"第 {state.Day} 天第 {attempt} 次古窟重打，实战种子 {run.Battle.Scenario.RandomSeed}，" +
+                    $"耗时 {run.Model.Elapsed:F1} 秒，俘获普通法师 {captives.Length} 名。");
+                foreach (var captive in captives)
+                {
+                    Need(BaseAftermath.Decide(state, captive.Id, "recruit"), "无法通过战后名册招降普通法师");
+                    Note($"招降 {captive.Id}，模板 {captive.Rpg?.TemplateId}，入伍生命 {captive.Health:F0}/{captive.Stats.Health:F0}。");
+                }
+                ResolveLoot(state);
+                if (BaseRuinsRewards.PendingBattle(state) != "")
+                    Need(BaseRuinsRewards.Skip(state), "无法放弃古窟重打的待领额外奖励");
+                Need(state.Demo.DeliveredDay > 0, "重打古窟改变了领主许可");
+                if (captives.Length > 0) return;
+            }
+            throw new InvalidOperationException("三次古窟重打均未取得存活的普通法师俘虏");
+        }
+
+        private static int BattleReadyRecruitedMages(BaseState state) => state.Workers
+            .Where(worker => worker.Kind == BaseTroopKind.Mage && worker.Recruited &&
+                BaseDevelopment.Eligible(state, "expedition", worker)).Sum(worker => worker.Count);
+
+        private static void RequireRosterMage(BaseState state, BasePrepRoute route)
+        {
+            var draft = BuildProgressionDraft(state, route, BaseMuster.BattleSoldierLimit);
+            Need(draft.AutoPlace() > 0 && draft.Units.Any(unit => unit.Kind == SoldierKind.Mage &&
+                draft.Positions.ContainsKey(unit.Id)), "实际备战与部署未包含招降的普通法师");
+        }
+    }
+}
