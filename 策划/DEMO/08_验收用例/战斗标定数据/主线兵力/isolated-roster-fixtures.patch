+        private static RosterFight[] RosterTrials(RosterCase sample, int count, int seed, int workers)
+        {
+            var trials = Enumerable.Range(0, count).Select(i => PrepareRosterFight(sample, seed + 1009 * i)).ToArray();
+            // Setup and final settlement use the real preparation and campaign APIs on the editor thread.
+            Parallel.ForEach(trials.Where(t => t.Run != null),
+                new ParallelOptions { MaxDegreeOfParallelism = workers }, SimulateRosterFight);
+            foreach (var trial in trials.Where(t => t.Run != null)) SettleRosterFight(trial);
+            return trials;
+        }
