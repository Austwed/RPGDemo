+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.IO;
+using System.Linq;
+using BaseConquest.Base;
+using BaseConquest.Battle;
+using BaseConquest.RealtimePrototype;
+using UnityEditor;
+using UnityEngine;
+
+namespace BaseConquest.Editor
+{
+    public static partial class VerifyDemoPlayerRoute
+    {
+        private const string RosterFixtureFolder = "Logs/main-battle-rosters";
+        private static readonly string[] RosterFixtureIds =
+        {
+            "cave-solo", "cave-two", "cave-three", "hideout", "defense", "blackcrow-early",
+            "blackcrow-restocked", "second-early-escaped", "second-restocked-escaped",
+            "second-early-dead", "second-restocked-dead"
+        };
+
+        private static readonly SoldierKind[] RosterKinds =
+        {
+            SoldierKind.Melee, SoldierKind.Ranged, SoldierKind.Cavalry, SoldierKind.Mage
+        };
+
+        public static void VerifyMainBattleRosterProgression()
+        {
+            const string difficulty = "BaseConquest.GlobalDifficulty";
+            bool hadDifficulty = PlayerPrefs.HasKey(difficulty);
+            string previousDifficulty = PlayerPrefs.GetString(difficulty);
+            var previousFacing = BaseInteraction.Facing;
+            var index = new Dictionary<string, string>();
+            var gaps = new Dictionary<string, string>();
+            int exitCode = 0;
+            Report.Clear();
+            Directory.CreateDirectory(RosterFixtureFolder);
+            foreach (string id in RosterFixtureIds)
+                File.Delete(Path.Combine(RosterFixtureFolder, id + ".json"));
+
+            try
+            {
+                PlayerPrefs.SetString(difficulty, "normal");
+                var config = DemoBalanceRuntime.Load();
+                string raw = File.ReadAllText(Path.Combine(Application.streamingAssetsPath,
+                    "BaseScenarios", BaseDemo.BalanceTemplate));
+                var state = OpenRoute(raw, config.Rules, config.WorkbookSha256, saveFixture: false);
+                Note($"普通难度，正式开局到醒来，配表 {state.Demo.ConfigHash}，战役种子 {state.Demo.Rpg.GenerationSeed}。");
+                BuildCaveRosterFixtures(state, index);
+                CreateDefenseRosterFixtures(state, index, gaps);
+                BuildPostDefenseRosterFixtures(state, index, gaps);
+                var required = RosterFixtureIds.Where(id => !id.StartsWith("second-", StringComparison.Ordinal));
+                Need(required.All(index.ContainsKey), "没有形成全部必需的备战样本");
+                Need(new[] { "dead", "escaped" }.Any(fate =>
+                    index.ContainsKey("second-early-" + fate) && index.ContainsKey("second-restocked-" + fate)),
+                    "没有形成同一巴图结局的两份第二波样本");
+                Note($"PASS：正式流程生成 {index.Count} 份可读备战样本。");
+            }
+            catch (Exception error)
+            {
+                exitCode = 2;
+                Note("FAIL：" + error.Message);
+                Debug.LogException(error);
+            }
+            finally
+            {
+                if (hadDifficulty) PlayerPrefs.SetString(difficulty, previousDifficulty);
+                else PlayerPrefs.DeleteKey(difficulty);
+                BaseInteraction.Facing = previousFacing;
+                File.WriteAllLines(Path.Combine(RosterFixtureFolder, "audit.txt"), Report);
+                var rows = new List<string>
+                {
+                    "id,file,route,day,batu,leaders,sword,bow,cavalry,mage,eligible_soldiers,l1,l2,food,materials,coins,notes"
+                };
+                rows.AddRange(RosterFixtureIds.Select(id => index.TryGetValue(id, out string row) ? row
+                    : id + new string(',', 16) + RosterCsv(gaps.TryGetValue(id, out string gap) ? gap : "样本未生成")));
+                File.WriteAllLines(Path.Combine(RosterFixtureFolder, "index.csv"), rows);
+            }
+            EditorApplication.Exit(exitCode);
+        }
+
+        private static void BuildCaveRosterFixtures(BaseState state, Dictionary<string, string> index)
+        {
+            Travel(state, "exit_east", "town");
+            At(state, "town_quest");
+            Need(BaseDemo.AcceptLordQuest(state), "无法领取古窟委托");
+            At(state, "demo_azhu");
+            Need(BaseDemoNpcs.InviteAzhu(state), "无法触发阿铸来访");
+
+            var solo = state.Copy();
+            EnterRosterCave(solo);
+            SaveRosterFixture(solo, "cave-solo", BasePrepRoute.Ruins, index);
+
+            BuyStones(state);
+            Travel(state, "travel_base", "base");
+            At(state, "home");
+            Need(BaseRpg.UpgradeCamp(state), "营帐升级未成功");
+            Travel(state, "exit_east", "town");
+            RecruitAzhu(state);
+            ReforgeGift(state);
+            var two = state.Copy();
+            EnterRosterCave(two);
+            SaveRosterFixture(two, "cave-two", BasePrepRoute.Ruins, index);
+
+            Travel(state, "travel_base", "base");
+            At(state, "demo_ahe");
+            Need(BaseDemoRuins.Meet(state, "partner_farm") && BaseDemoRuins.Join(state, "partner_farm"),
+                "无法招募阿禾");
+            Travel(state, "exit_east", "town");
+            EnterRosterCave(state);
+            SaveRosterFixture(state, "cave-three", BasePrepRoute.Ruins, index);
+
+            var run = OpenProgressionBattle(state, BasePrepRoute.Ruins, 0);
+            ApproachController(run, true, 5400);
+            Need(BaseDemoRuins.Complete(state, run), "古窟三队长路线未胜利并完成离场");
+            Need(BaseDemoStories.AcceptController(state, state.Demo.Flow.FirstControllerId), "无法接纳迦兰");
+            ResolveLoot(state);
+            At(state, "demo_rescued_1");
+            Need(BaseSceneRules.TalkRescued(state), "找不到获救村民");
+            for (int frame = 0; frame < 900 && state.Demo.Rescue.Stage == 2; frame++)
+                BaseSceneRules.TickRescued(state, .05);
+            Need(state.Demo.Rescue.Stage == 3, "获救村民未返镇");
+            Travel(state, "demo_ruins_return", "town");
+            At(state, "town_quest");
+            Need(BaseDemoRuins.Deliver(state), "未取得募兵及设施修复许可");
+            Note($"古窟首通完成，已领募兵许可，耗时 {run.Model.Elapsed:F1} 秒；未招降俘虏。");
+        }
+
+        private static void EnterRosterCave(BaseState state)
+        {
+            Travel(state, "demo_ruins_exit", "outpost");
+            At(state, "demo_ruins_investigate");
+            Need(state.Demo.RuinsDay == 0 && !state.Campaign.HasActiveBattle && state.Workers.Count == 0,
+                "古窟样本不是首通或已持有士兵");
+        }
+
+        private static void CreateDefenseRosterFixtures(BaseState state, Dictionary<string, string> index,
+            Dictionary<string, string> gaps)
+        {
+            while (!BaseDemoDefense.Due(state))
+            {
+                BuyRosterTroops(state, 11, 0);
+                Travel(state, "travel_base", "base");
+                RepairAndAssign(state);
+                if (!index.ContainsKey("hideout") && EligibleRosterTroops(state) >= 10 &&
+                    BaseSupply.Available(state, "supply", 1) >= 10)
+                    TryRosterBranch("土匪窝点", () => CaptureHideoutRoster(state.Copy(), index),
+                        problem => gaps["hideout"] = problem);
+                Rest(state);
+                if (!BaseDemoDefense.Due(state)) Travel(state, "exit_east", "town");
+            }
+
+            if (!index.ContainsKey("hideout"))
+            {
+                var hideout = state.Copy();
+                TryRosterBranch("土匪窝点", () => CaptureHideoutRoster(hideout, index),
+                    problem => gaps["hideout"] = problem);
+            }
+            EnterDefenseField(state);
+            SaveRosterFixture(state, "defense", BasePrepRoute.Defense, index);
+        }
+
+        private static void CaptureHideoutRoster(BaseState state, Dictionary<string, string> index)
+        {
+            Travel(state, "exit_east", "town");
+            BuyRosterGood(state, "supply1", Math.Max(0, Math.Min(10, EligibleRosterTroops(state)) -
+                BaseSupply.Available(state, "supply", 1)), 0);
+            Travel(state, "demo_ruins_exit", "outpost");
+            At(state, BaseBanditHideout.EntryId);
+            SaveRosterFixture(state, "hideout", BasePrepRoute.Hideout, index);
+        }
+
+        private static void BuildPostDefenseRosterFixtures(BaseState defense, Dictionary<string, string> index,
+            Dictionary<string, string> gaps)
+        {
+            var branches = new Dictionary<string, BaseState>();
+            TryRosterBranch("首防及时结束追击", () => RecordDefenseBranch(defense.Copy(), false, branches));
+            TryRosterBranch("首防主动追击巴图", () => RecordDefenseBranch(defense.Copy(), true, branches));
+            Need(branches.Count > 0, "正式首防未胜利，不能生成后续战役样本");
+
+            var baseline = branches.Values.First();
+            var early = baseline.Copy();
+            MarchRosterToBlackCrow(early, 10);
+            SaveRosterFixture(early, "blackcrow-early", BasePrepRoute.BlackCrow, index);
+
+            var restocked = baseline.Copy();
+            Rest(restocked);
+            RestockCampaignRoster(restocked, 14, false);
+            MarchRosterToBlackCrow(restocked, 14);
+            SaveRosterFixture(restocked, "blackcrow-restocked", BasePrepRoute.BlackCrow, index);
+
+            foreach (string fate in new[] { "escaped", "dead" })
+            {
+                if (!branches.TryGetValue(fate, out var afterDefense))
+                {
+                    string reason = "正常首防策略没有实际得到此巴图结局";
+                    gaps["second-early-" + fate] = gaps["second-restocked-" + fate] = reason;
+                    Note($"第二波 {fate} 缺项：{reason}。");
+                    continue;
+                }
+                foreach (bool restock in new[] { false, true })
+                {
+                    string id = "second-" + (restock ? "restocked-" : "early-") + fate;
+                    TryRosterBranch(id, () =>
+                    {
+                        var second = afterDefense.Copy();
+                        while (!BaseDemoDefense.SecondDue(second))
+                        {
+                            if (restock) RestockCampaignRoster(second, 20, true);
+                            Rest(second);
+                        }
+                        EnterDefenseField(second);
+                        SaveRosterFixture(second, id, BasePrepRoute.Second, index);
+                    }, problem => gaps[id] = problem);
+                }
+            }
+        }
+
+        private static void RecordDefenseBranch(BaseState state, bool pursue, Dictionary<string, BaseState> branches)
+        {
+            var run = OpenProgressionBattle(state, BasePrepRoute.Defense, 11);
+            var batu = run.Battle.Commander(BattleSide.B, 0);
+            Need(batu != null, "首防缺少巴图");
+            var target = run.Model.Units.Single(unit => unit.Id == batu.Id + 1);
+            run.Model.SetPaused(false);
+            for (int frame = 0; frame < 60 * 85 && run.Battle.Phase == BattlePhase.Fighting; frame++)
+            {
+                if (run.VictoryExitOpen)
+                {
+                    run.OrderBattlefieldExit(null);
+                    Tick(run, 3600);
+                    break;
+                }
+                if (run.DefensePursuitReady && (!pursue || !target.Alive || frame >= 60 * 75))
+                    Need(run.FinishDefensePursuit(), "无法结束首防追击");
+                if (pursue && target.Alive && frame % 120 == 0 && run.Battle.PlayerCanSee(BattleSide.A, batu))
+                {
+                    var captains = run.Model.Units.Where(unit => unit.Side == PrototypeSide.Ally && unit.Alive &&
+                        unit.Role == PrototypeRole.Leader && unit.TargetId != target.Id).Select(unit => unit.Id - 1).ToArray();
+                    if (captains.Length > 0)
+                        run.Issue(captains, PrototypeOrder.Focus, target.Position, batu.Id, squadFocus: true);
+                }
+                run.Tick(1d / 60);
+            }
+            Need(BaseDemoDefense.Complete(state, run), $"首防未完成结算：{run.Battle.Report?.Outcome}");
+            BaseDemoDefense.AcknowledgeBatu(state);
+            ResolveLoot(state);
+            string fate = state.Demo.Defense.BatuFate;
+            Note($"第 {state.Day} 天首防实战 {run.Model.Elapsed:F1} 秒，{(pursue ? "追击巴图" : "及时结束追击")}，" +
+                 $"巴图 {fate}，第二波到达日 {BaseDemoDefense.SecondArrival(state)}，可用士兵 {EligibleRosterTroops(state)}。");
+            if (!branches.ContainsKey(fate)) branches.Add(fate, state);
+        }
+
+        private static RealtimeCampaignBattle OpenProgressionBattle(BaseState state, BasePrepRoute route, int target)
+        {
+            var draft = BuildProgressionDraft(state, route, target);
+            Need(draft.AutoPlace() > 0 && draft.Positions.ContainsKey(draft.PlayerId), route + "自动布置失败");
+            Need(draft.Problem(state, true) == "", route + "布置校验失败：" + draft.Problem(state, true));
+            var run = new RealtimeCampaignBattle(draft.Begin(state));
+            run.EnableBattlefieldExits();
+            if (route == BasePrepRoute.Ruins) BaseDemoRuins.Configure(run);
+            else BaseDemoDefense.Configure(run);
+            foreach (var captain in run.Battle.Soldiers.Where(unit => unit.Side == BattleSide.A && unit.Kind == SoldierKind.Hero))
+                run.Strategy(captain.OriginCommanderSlot, route == BasePrepRoute.Defense ? SquadStrategy.Protect : SquadStrategy.Attack);
+            return run;
+        }
+
+        private static BaseBattlePreparation BuildProgressionDraft(BaseState state, BasePrepRoute route, int target)
+        {
+            var draft = new BaseBattlePreparation(state, route) { SupplyGrade = 1 };
+            var captains = draft.Units.Where(unit => unit.Kind == SoldierKind.Hero).Take(BaseAdventure.Capacity).ToArray();
+            Need(captains.Any(unit => unit.Id == draft.PlayerId), "备战名册缺少主角");
+            foreach (var unit in draft.Units) unit.Selected = captains.Contains(unit);
+            var soldiers = draft.Units.Where(unit => unit.Kind != SoldierKind.Hero)
+                .OrderByDescending(unit => unit.Health / unit.MaxHealth).ThenBy(unit => unit.SoldierNumber).ToArray();
+            int limit = Math.Min(target, Math.Min(draft.AvailableSupply(state, 1), BaseMuster.BattleSoldierLimit));
+            if (route == BasePrepRoute.Travel)
+                limit = Math.Min(limit, state.Inventory.Food / Math.Max(1, state.Rules.SoldierFood));
+            var formation = RosterKinds.Select(kind => soldiers.FirstOrDefault(unit => unit.Kind == kind))
+                .Where(unit => unit != null).Concat(soldiers).Distinct().Take(limit).ToArray();
+            for (int soldier = 0; soldier < formation.Length; soldier++)
+            {
+                formation[soldier].Selected = true;
+                formation[soldier].TeamId = captains[soldier % captains.Length].Id;
+            }
+            Need(draft.Problem(state, false) == "", route + "编队校验失败：" + draft.Problem(state, false));
+            return draft;
+        }
+
+        private static void MarchRosterToBlackCrow(BaseState state, int target)
+        {
+            BuyMarchSupply(state);
+            At(state, "demo_march_exit");
+            BaseDemoFinale.OpenWorld(state);
+            BaseAdventure.RecallPaused(state);
+            var draft = BuildProgressionDraft(state, BasePrepRoute.Travel, target);
+            var journey = BaseWorldJourney.Plan(state, null, "bandit", "camp_entry");
+            Need(journey.Reachable && journey.Days == 1, "黑鸦寨没有一日可达的正式路线");
+            int day = state.Day;
+            int food = state.Inventory.Food;
+            BaseWorldJourney.Depart(state, "camp_entry", journey.Path, draft, false);
+            int prepaid = food - state.Inventory.Food;
+            Need(BaseWorldJourney.Step(state, _ => null) && state.Day == day + 1, "行军未结算");
+            BaseWorldJourney.EnterScene(state, "bandit_entry");
+            At(state, "demo_camp_attack");
+            var arrived = new BaseBattlePreparation(state, BasePrepRoute.BlackCrow);
+            var expected = draft.Units.Where(unit => unit.Selected && unit.Kind != SoldierKind.Hero)
+                .Select(unit => unit.SoldierNumber).OrderBy(number => number).ToArray();
+            Need(arrived.Units.Where(unit => unit.Kind != SoldierKind.Hero).Select(unit => unit.SoldierNumber)
+                .OrderBy(number => number).SequenceEqual(expected), "到达名册和实际出征士兵不同");
+            Note($"灰岩营地第 {day} 天出发，第 {state.Day} 天抵达寨外；预扣路粮 {prepaid}，随行士兵 {expected.Length}。");
+        }
+
+        private static int EligibleRosterTroops(BaseState state) => state.Workers
+            .Where(worker => BaseDevelopment.Eligible(state, "expedition", worker)).Sum(worker => worker.Count);
+
+        private static void RestockCampaignRoster(BaseState state, int target, bool industrial)
+        {
+            Travel(state, "exit_east", "town");
+            BuyRosterTroops(state, target, industrial ? 55 : 25);
+            if (state.Inventory.Food < 70)
+                BuyRosterGood(state, "food", 110 - state.Inventory.Food, 0);
+            int stock = BaseSupply.Available(state, "supply", 1);
+            if (stock < target && industrial && state.Inventory.Materials < 12)
+                BuyRosterGood(state, "materials", 18 - state.Inventory.Materials, 25);
+            if (stock < target)
+                BuyRosterGood(state, "supply1", target - stock, 0);
+            Travel(state, "travel_base", "base");
+            RepairAndAssign(state);
+        }
+
+        private static void BuyRosterTroops(BaseState state, int target, int reserveCoins)
+        {
+            var types = new[] { BaseTroopKind.Melee, BaseTroopKind.Ranged, BaseTroopKind.Cavalry };
+            int Count(BaseTroopKind kind) => state.Workers.Where(worker => worker.Kind == kind && worker.Health > 0)
+                .Sum(worker => worker.Count);
+            int Preference(BaseTroopKind kind) => kind == BaseTroopKind.Cavalry ? 1 : 0;
+            At(state, "town_recruit");
+            var hired = new List<BaseTroopKind>();
+            int before = state.Inventory.Coins;
+            while (types.Sum(Count) < target)
+            {
+                var order = types.OrderBy(kind => Count(kind) + Preference(kind)).ToArray();
+                bool bought = false;
+                foreach (var kind in order.Where(kind => BaseTown.MaxHire(state, kind) > 0))
+                {
+                    var quote = BaseTown.QuoteHire(state, kind, 1);
+                    if (quote == null || state.Inventory.Coins - quote.Total < reserveCoins) continue;
+                    Need(BaseTown.Confirm(state, quote), "募兵交易未生效：" + kind);
+                    hired.Add(kind);
+                    bought = true;
+                    break;
+                }
+                if (!bought) break;
+            }
+            Note($"第 {state.Day} 天募兵 {string.Join("/", types.Select(kind => hired.Count(item => item == kind)))}，" +
+                 $"实付 {before - state.Inventory.Coins} 币，在册 {string.Join("/", types.Select(Count))}。");
+        }
+
+        private static void BuyRosterGood(BaseState state, string id, int wanted, int reserveCoins)
+        {
+            if (wanted <= 0) return;
+            At(state, "town_market");
+            int max = Math.Min(wanted, BaseTown.MaxTrade(state, id, true));
+            for (int quantity = max; quantity > 0; quantity--)
+            {
+                var quote = BaseTown.QuoteTrade(state, id, true, quantity);
+                if (quote == null || state.Inventory.Coins - quote.Total < reserveCoins) continue;
+                int before = state.Inventory.Coins;
+                Need(BaseTown.Confirm(state, quote), "市场交易未生效：" + id);
+                Note($"第 {state.Day} 天市场购入 {id} {quantity}，实付 {before - state.Inventory.Coins} 币。");
+                return;
+            }
+        }
+
+        private static void SaveRosterFixture(BaseState state, string id, BasePrepRoute route, Dictionary<string, string> index)
+        {
+            BaseEconomy.Validate(state);
+            var actual = new BaseBattlePreparation(state, route);
+            int capacity = Math.Min(BaseMuster.BattleSoldierLimit, actual.Units.Count(unit => unit.Kind != SoldierKind.Hero));
+            var draft = BuildProgressionDraft(state, route, capacity);
+            Need(draft.AutoPlace() > 0 && draft.Problem(state, true) == "", "样本不能用于正式部署：" + id);
+            var picks = draft.Units.Where(unit => draft.Positions.ContainsKey(unit.Id)).ToArray();
+            var captains = picks.Where(unit => unit.Kind == SoldierKind.Hero).ToArray();
+            int[] mix = RosterKinds.Select(kind => picks.Count(unit => unit.Kind == kind)).ToArray();
+            string notes = "队长：" + string.Join("、", captains.Select(unit =>
+                unit.Name + " " + unit.Health.ToString("0", CultureInfo.InvariantCulture) + "/" + unit.MaxHealth.ToString("0", CultureInfo.InvariantCulture)));
+            foreach (var unit in captains)
+            {
+                var leader = state.Leaders.Single(person => person.Id == unit.Id);
+                var stats = BasePersonalEquipment.Stats(leader);
+                string gear = string.Join("、", leader.PersonalEquipment.Items.Select(item => $"{item.Slot}/{item.Template}/{item.Quality}"));
+                Note($"{id} {unit.Name} · 攻 {stats.Damage:g} 防 {stats.Defense:g} · 装备 {(gear.Length == 0 ? "空" : gear)}。");
+            }
+            string file = id + ".json";
+            string json = JsonUtility.ToJson(state);
+            var readback = JsonUtility.FromJson<BaseState>(json);
+            BaseEconomy.Validate(readback);
+            Need(readback.Day == state.Day && readback.PlayerLeaderId == state.PlayerLeaderId &&
+                 readback.Inventory.Coins == state.Inventory.Coins, "备战样本 JSON 回读不一致：" + id);
+            File.WriteAllText(Path.Combine(RosterFixtureFolder, file), json);
+            int one = draft.AvailableSupply(state, 1), two = draft.AvailableSupply(state, 2);
+            string fate = state.Demo.Defense.BatuFate ?? "";
+            index.Add(id, $"{id},{file},{route},{state.Day},{fate},{captains.Length},{string.Join(",", mix)}," +
+                $"{capacity},{one},{two},{state.Inventory.Food},{state.Inventory.Materials},{state.Inventory.Coins},{RosterCsv(notes)}");
+            Note($"{id} 第 {state.Day} 天 {captains.Length}+{mix.Sum()}（剑弓骑法 {string.Join("/", mix)}），" +
+                 $"合规可选士兵 {capacity}，一级/二级军需 {one}/{two}，粮 {state.Inventory.Food}，" +
+                 $"原料 {state.Inventory.Materials}，钱 {state.Inventory.Coins}，巴图 {fate}。{notes}");
+        }
+
+        private static void TryRosterBranch(string label, Action action, Action<string> failure = null)
+        {
+            try { action(); }
+            catch (InvalidOperationException error)
+            {
+                Note(label + "未生成：" + error.Message);
+                failure?.Invoke(error.Message);
+            }
+        }
+
+        private static string RosterCsv(string value) => "\"" + value.Replace("\"", "\"\"") + "\"";
+    }
+}
