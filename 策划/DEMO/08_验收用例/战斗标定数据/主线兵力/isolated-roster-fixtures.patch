+        private static void SimulateRosterFight(RosterFight trial)
+        {
+            var run = trial.Run;
+            var route = trial.Case.Route;
+            bool defend = route is BasePrepRoute.Defense or BasePrepRoute.Second;
+            foreach (var captain in run.Model.Units.Where(RosterAlliedLeader))
+                run.Strategy(captain.Squad, trial.Case.Guided && defend ? SquadStrategy.Protect : SquadStrategy.Attack);
+            run.Model.SetPaused(false);
+            bool exitRequested = false;
+            int max = route == BasePrepRoute.Ruins ? 90 * 8 : 120 * 8;
+            for (int step = 0; step < max && run.Battle.Phase == BattlePhase.Fighting; step++)
+            {
+                if (run.RuinsExitOpen)
+                {
+                    VerifyChenanAndRuins.WalkOutOfRuins(run);
+                    break;
+                }
+                if (trial.Case.ExitAtHalf && !exitRequested && run.Model.Player.Alive &&
+                    run.Model.Player.Health <= run.Model.Player.MaxHealth * .5 &&
+                    run.OrderBattlefieldExit(null))
+                {
+                    exitRequested = true;
+                    trial.Orders++;
+                }
+                if (run.DefensePursuitReady) run.FinishDefensePursuit();
+                if (trial.Case.Guided && route == BasePrepRoute.Second && step == 35 * 8 && !run.VictoryExitOpen)
+                {
+                    foreach (var captain in run.Model.Units.Where(RosterAlliedLeader))
+                        run.Strategy(captain.Squad, SquadStrategy.Attack);
+                    trial.Orders++;
+                }
+                if (run.VictoryExitOpen)
+                {
+                    if (step % 8 == 0) run.OrderBattlefieldExit(null);
+                }
+                else if (trial.Case.Guided && !defend && step % 12 == 0)
+                    RunRosterGuidance(trial, step);
+                if (run.Battle.Phase == BattlePhase.Fighting) run.Tick(.125);
+            }
+            trial.Outcome = run.Battle.Report?.Outcome.ToString() ?? "timeout";
+            if (trial.Outcome is "RoundLimit" or "Stalemate") trial.Outcome = "timeout";
+            trial.Seconds = run.Model.Elapsed;
+            var own = run.Battle.Soldiers.Where(u => u.Side == BattleSide.A && u.Kind != SoldierKind.Hero).ToArray();
+            trial.Deaths = own.Count(u => u.InstantDead);
+            trial.Down = own.Count(u => !u.InstantDead && u.KnockedDown);
+        }
+
+        private static bool RosterAlliedLeader(PrototypeUnit unit) => unit.Side == PrototypeSide.Ally &&
+            unit.Role == PrototypeRole.Leader && unit.Alive;
+
+        private static void RunRosterGuidance(RosterFight trial, int step)
+        {
+            var run = trial.Run;
+            var route = trial.Case.Route;
+            var leaders = run.Model.Units.Where(RosterAlliedLeader).ToArray();
+            if (leaders.Length == 0) return;
+            var enemy = run.Battle.Soldiers.Where(u => u.Side == BattleSide.B && u.IsActive &&
+                    run.Battle.PlayerCanSee(BattleSide.A, u) &&
+                    (route != BasePrepRoute.Ruins || u.Kind == SoldierKind.Hero))
+                .OrderByDescending(u => u.Kind == SoldierKind.Hero).ThenBy(u => u.Health).ThenBy(u => u.Id).FirstOrDefault();
+            if (enemy != null)
+            {
+                var actor = run.Model.Units.Single(u => u.Id == enemy.Id + 1);
+                int[] needed = leaders.Where(u => !u.ManualOrder || u.TargetId != actor.Id).Select(u => u.Id - 1).ToArray();
+                if (needed.Length != 0 && run.Issue(needed, PrototypeOrder.Focus, actor.Position, enemy.Id,
+                    commanderOnly: route == BasePrepRoute.Ruins, squadFocus: route != BasePrepRoute.Ruins))
+                    trial.Orders++;
+                return;
+            }
+            if (step % 72 != 0 || route == BasePrepRoute.Hideout) return;
+            var board = run.Battle.Board;
+            PrototypePoint position;
+            int[] going;
+            if (route == BasePrepRoute.Ruins)
+            {
+                var boss = run.Battle.Commander(BattleSide.B, 0);
+                position = run.Model.Units.Single(u => u.Id == boss.Id + 1).Position;
+                going = leaders.Select(u => u.Id - 1).ToArray();
+            }
+            else
+            {
+                int row = step % 144 == 0 ? 2 * board.Height / 3 : board.Height / 3;
+                var scout = board.Positions().Where(board.Walkable)
+                    .OrderBy(c => Math.Abs(c.X - 3 * board.Width / 4) + Math.Abs(c.Z - row)).First();
+                position = new PrototypePoint(scout.X + .25, scout.Z + .25);
+                var lead = leaders.FirstOrDefault(u => run.Battle.Soldier(u.Id - 1).ProfessionKind == SoldierKind.Cavalry);
+                going = step == 0 && lead != null ? new[] { lead.Id - 1 } : leaders.Select(u => u.Id - 1).ToArray();
+            }
+            if (run.Issue(going, PrototypeOrder.Move, position, commanderOnly: route == BasePrepRoute.Ruins)) trial.Orders++;
+        }
+
+        private static void SettleRosterFight(RosterFight trial)
+        {
+            var run = trial.Run;
+            if (trial.Outcome == "SideAWin")
+            {
+                trial.Settled = trial.Case.Route switch
+                {
+                    BasePrepRoute.Ruins => BaseDemoRuins.Complete(trial.State, run),
+                    BasePrepRoute.Hideout => BaseBanditHideout.Complete(trial.State, run),
+                    BasePrepRoute.BlackCrow => BaseDemoFinale.Complete(trial.State, run),
+                    _ => BaseDemoDefense.Complete(trial.State, run)
+                };
+                if (!trial.Settled) throw new InvalidOperationException("victory settlement failed for " + trial.Case.Id);
+            }
+            else if (trial.Case.Route == BasePrepRoute.Second && trial.Outcome == "SideBWin" &&
+                (!BaseDemoCombat.Fail(trial.State, run) || !trial.State.Aftermath.GameOver))
+                throw new InvalidOperationException("second-wave failure did not end the campaign");
+            if (trial.Settled) trial.SupplyUsed = trial.State.Campaign.Reports.LastOrDefault()?.GearLost ?? 0;
+        }
